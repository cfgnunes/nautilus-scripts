#!/usr/bin/env bash
# install_icon_kde=edit-find
# install_keyboard_shortcut=<Control><Alt>0

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local std_output=""

    # Execute initial checks.
    _display_wait_box ""
    input_files=$(_get_files "par_type=all")

    # Split the list into an array.
    local -a items=()
    read -r -d "" -a items < <(printf "%s" "$input_files")

    # Run the main process.
    std_output=$(find -L "${items[@]}" \
        ! -regex "$IGNORE_FIND" \
        -type f -empty -printf "%p\n" 2>/dev/null)

    std_output=$(_text_remove_pwd "$std_output")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'files')
        par_columns='--column:$(_i18n 'File')'
        par_action=delete_item
        par_check_type=checkbox
    "
}

_main "$@"

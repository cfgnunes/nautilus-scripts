#!/usr/bin/env bash
# install_mime_type=inode/directory;
# install_icon_kde=collapse-all

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""

    # Execute initial checks.
    _display_wait_box ""
    input_files=$(_get_files "par_type=directory; par_max_items=1")

    local msg=""
    msg+="$(_i18n 'This action will move all files from subdirectories to the root of the selected directory.')"
    msg+="\n\n"
    msg+="$(_i18n 'Would you like to continue?')"
    if ! _display_question_box "$msg"; then
        _exit_script
    fi

    # Run the main process.
    _flatten_directory "$input_files"

    _display_result_box ""
}

_flatten_directory() {
    local directory=$1
    local undo_script=""
    local temp_file=""
    local filename=""
    local exit_code=0

    # Create a temporary file to store the list of files to move.
    temp_file=$(_make_temp_file)

    # Create an 'undo script' to reverse the flattening operation.
    undo_script=$(_make_undo_script "$directory")

    if ! _directory_push "$directory"; then
        rm -f -- "$temp_file"
        return 1
    fi

    # Generate a list of all files (not directories) in the current directory and its subdirectories.
    find . -mindepth 2 -not -type d -print0 2>/dev/null >>"$temp_file"

    # For each directory, add a command to the 'undo script' to recreate the directory structure.
    local dir_path=""
    while IFS= read -r -d '' dir_path; do
        printf "mkdir -p -- %q\n" "$dir_path" >>"$undo_script"
    done < <(find . -mindepth 1 -type d -print0 2>/dev/null)

    # Loop through each file in the list and move it to the root directory.
    local full_path_filename=""
    while IFS= read -r -d '' full_path_filename; do
        # Get the file's name (basename) for moving it to the root directory.
        filename="./$(basename -- "$full_path_filename")"

        # Move the file to the root directory.
        _move_file "skip" "$full_path_filename" "$filename"
        exit_code=$?

        # If the file was moved successfully and the name was changed, add to the 'undo script'.
        if ((exit_code == 0)); then
            # Print 'mv' command in Undo script.
            printf "mv -n -- %q %q\n" "$filename" "$full_path_filename" >>"$undo_script"
        fi
    done <"$temp_file"

    # Remove any empty directories that remain after moving the files.
    find . -type d -empty -delete 2>/dev/null

    local pop_status=0
    _directory_pop || pop_status=1

    # Remove the temporary files.
    rm -f -- "$temp_file"

    return "$pop_status"
}

_make_undo_script() {
    local output_dir=$1
    local undo_script_name="undo-flatten.sh"

    # Generate a file name for the undo script.
    local output_file=""
    output_file=$(_get_output_filename "$undo_script_name" "$output_dir" "par_extension_opt=preserve")

    # Create the undo script with a header and usage instructions.
    {
        printf "%s\n" "#!/usr/bin/env bash"
        printf "%s\n" "# ============================================================================="
        printf "%s\n" "# Description: This script is automatically generated to reverse the directory"
        printf "%s\n" "# flattening process. It restores the original directory structure and moves"
        printf "%s\n" "# files back to their respective subdirectories."
        printf "%s\n" "#"
        printf "%s\n" "# Usage:"
        printf "%s\n" "#   bash $undo_script_name"
        printf "%s\n" "#"
        printf "%s\n" "# Note: This script assumes no additional changes were made to the directory"
        printf "%s\n" "# structure after the flattening operation."
        printf "%s\n" "# ============================================================================="
        printf "\n"
    } >"$output_file"

    # Make the 'undo script' executable.
    chmod +x -- "$output_file"

    # Return the path of the generated 'undo script'.
    printf "%s" "$output_file"
}

_main "$@"

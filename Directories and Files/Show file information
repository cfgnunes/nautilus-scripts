#!/usr/bin/env bash
# install_icon_kde=documentinfo
# install_keyboard_shortcut=<Control><Alt>I

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _display_wait_box ""
    _get_files "par_type=file; par_recursive=true" "input_files"

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "input_files" "$output_dir"

    local std_output=""
    std_output=$(_storage_text_read_all)
    std_output=$(_str_sort "$std_output" "$ITEM_SEP" "false")
    std_output=$(tr "$ITEM_SEP" "\n" <<<"$std_output")

    _display_text_box "$std_output" "File information.txt"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""

    # Run the main process.
    std_output=$(file --brief --no-pad -- "$input_file")

    if [[ -z "$std_output" ]]; then
        return
    fi

    _storage_text_write "$std_output: \"$(_text_remove_pwd "$input_file")\""
}

_main "$@"

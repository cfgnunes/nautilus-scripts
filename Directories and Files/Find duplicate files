#!/usr/bin/env bash
# install_icon_kde=edit-find
# install_keyboard_shortcut=<Control><Alt>U

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local std_output=""
    local temp_file=""

    # Execute initial checks.
    _check_dependencies "rdfind"
    _display_wait_box ""
    _get_files "par_type=all" "input_files"

    # Work on a temporary file.
    temp_file=$(_make_temp_file)

    # Run the main process.
    # NOTE: The 'rdfind' does not support '--' in the command line.
    _run_in_sandbox "" "false" \
        rdfind -dryrun true -removeidentinode false -outputname \
        "$temp_file" "${input_files[@]}" &>/dev/null

    # Parse the output.
    # NOTE: A file name with newlines spans many lines in the output.
    std_output=$(awk \
        -v col_sep="$COL_SEP" \
        -v row_sep="$ITEM_SEP" '
        function add_file(file) {
            # Replace double slashes with a single slash.
            gsub(/\/+/, "/", file)

            # Skip files inside a .git directory.
            if (file ~ /\.git\//)
                return

            # Hold the first file until a second one shows up.
            if (++n == 1) {
                first = file
                return
            }

            # The group has 2+ files: assign the ID and print the held file.
            if (n == 2) {
                id++
                printf "%s%s%s%s", id, col_sep, first, row_sep
            }

            printf "%s%s%s%s", id, col_sep, file, row_sep
        }

        function flush() {
            if (pending)
                add_file(file)
            pending = 0
        }

        /^DUPTYPE_/ {
            flush()

            # A first-occurrence line starts a new group.
            if ($0 ~ /^DUPTYPE_FIRST_OCCURRENCE/)
                n = 0

            # Extract the file path starting from field 8.
            file = substr($0, index($0, $8))
            pending = 1
            next
        }

        # A line without the prefix continues a file name with newlines.
        pending && !/^# end of file/ { file = file "\n" $0 }

        END { flush() }' <"$temp_file")
    rm -f -- "$temp_file"

    std_output=$(_text_remove_pwd "$std_output")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'files')
        par_columns='--column:$(_i18n 'Group'),--column:$(_i18n 'File')'
        par_action=open_location
        par_check_type=checkbox
    "
}

_main "$@"

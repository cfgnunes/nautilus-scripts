#!/usr/bin/env bash
# install_icon_kde=user-group-properties
# install_keyboard_shortcut=<Control><Alt>P

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local std_output=""

    # Execute initial checks.
    _display_wait_box ""
    _get_files "par_type=all" "input_files"

    # Run the main process.
    std_output=$(find "${input_files[@]}" \
        ! -regex "$IGNORE_FIND" \
        -printf "%m$COL_SEP%u$COL_SEP%g$COL_SEP%y$COL_SEP%p$ITEM_SEP" 2>/dev/null)

    std_output=$(_text_remove_pwd "$std_output")
    std_output=$(_str_sort "$std_output" "$ITEM_SEP" "false")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'items')
        par_columns='--column:$(_i18n 'Octal'),--column:$(_i18n 'User'),'
        par_columns+='--column:$(_i18n 'Group'),--column:$(_i18n 'Type'),'
        par_columns+='--column:$(_i18n 'File')'
        par_action=open_location
        par_check_type=checkbox
    "
}

_main "$@"

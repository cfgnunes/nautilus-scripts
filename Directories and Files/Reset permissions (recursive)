#!/usr/bin/env bash
# install_icon_kde=edit-reset

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""

    # Execute initial checks.
    _display_wait_box ""
    input_files=$(_get_files "par_type=all")

    local msg=""
    msg+="$(_i18n 'This action will reset the permissions recursively.')"
    msg+="\n\n"
    msg+="$(_i18n 'Would you like to continue?')"
    if ! _display_question_box "$msg"; then
        _exit_script
    fi

    # Run the main process.
    _reset_permissions "$input_files"

    _display_result_box ""
}

_reset_permissions() {
    local input_files=$1
    local new_permission=""
    local std_output=""
    local dir_pattern=""
    local pattern=""
    local find_args=""

    # Split the list into an array.
    local -a items=()
    read -r -a items <<<"$input_files"

    # List of sensitive directories to apply strict permissions (700).
    local -a sensitive_dirs=(
        ".aws"
        ".azure"
        ".cert"
        ".docker"
        ".git-credential-cache"
        ".gnupg"
        ".kube"
        ".mozilla"
        ".password-store"
        ".pki"
        ".ssh"
        ".thunderbird"
    )

    # List of sensitive files to apply strict permissions (600).
    local -a sensitive_files=(
        ".authinfo.gpg"
        ".authinfo"
        ".bash_aliases"
        ".bash_history"
        ".bash_login"
        ".bash_logout"
        ".bash_profile"
        ".bashrc"
        ".curlrc"
        ".git-credentials"
        ".gitconfig"
        ".my.cnf"
        ".mysql_history"
        ".netrc"
        ".npmrc"
        ".pg_service.conf"
        ".pgpass"
        ".profile"
        ".psql_history"
        ".pypirc"
        ".python_history"
        ".rediscli_history"
        ".rhosts"
        ".sh_history"
        ".viminfo"
        ".wget-hsts"
        ".wgetrc"
        ".Xauthority"
        ".zlogin"
        ".zlogout"
        ".zprofile"
        ".zsh_history"
        ".zshenv"
        ".zshrc"
        "authorized_keys"
        "id_dsa"
        "id_ecdsa"
        "id_ed25519"
        "id_rsa"
        "known_hosts"
        "privatekey.asc"
        "privatekey.gpg"
        "pubring.kbx"
        "secring.gpg"
        "trustdb.gpg"
    )

    # -------------------------------------------------------------------------
    # Step 1: Directories (0777 & ~umask).
    # -------------------------------------------------------------------------
    new_permission=$(printf "%04o" "$((0777 & ~$(umask)))")
    find_args=("${items[@]}" ! -regex "$IGNORE_FIND")
    for pattern in "${sensitive_dirs[@]}"; do
        find_args+=(! -path "*/$pattern/*" ! -name "$pattern")
    done
    find_args+=(-type d -exec chmod "$new_permission" -- {} \;)
    std_output=$(find "${find_args[@]}" 2>&1)
    _check_output "$?" "$std_output" "" ""

    # -------------------------------------------------------------------------
    # Step 2: Sensitive directories (700).
    # -------------------------------------------------------------------------
    new_permission=700
    for dir_pattern in "${sensitive_dirs[@]}"; do
        find "${items[@]}" \
            ! -regex "$IGNORE_FIND" \
            -type d -name "$dir_pattern" \
            -exec chmod "$new_permission" -- {} \;
    done

    # -------------------------------------------------------------------------
    # Step 3: Directories inside sensitive directories (700).
    # -------------------------------------------------------------------------
    new_permission=700
    for dir_pattern in "${sensitive_dirs[@]}"; do
        find "${items[@]}" \
            ! -regex "$IGNORE_FIND" \
            -type d -path "*/$dir_pattern/*" \
            -exec chmod "$new_permission" -- {} \;
    done

    # -------------------------------------------------------------------------
    # Step 4: Files inside sensitive directories (600).
    # -------------------------------------------------------------------------
    new_permission=600
    for dir_pattern in "${sensitive_dirs[@]}"; do
        find "${items[@]}" \
            ! -regex "$IGNORE_FIND" \
            -type f -path "*/$dir_pattern/*" \
            -exec chmod "$new_permission" -- {} +
    done

    # -------------------------------------------------------------------------
    # Step 5: Sensitive files (600).
    # -------------------------------------------------------------------------
    new_permission=600
    for pattern in "${sensitive_files[@]}"; do
        find "${items[@]}" \
            ! -regex "$IGNORE_FIND" \
            -type f -name "$pattern" \
            -exec chmod "$new_permission" -- {} +
    done

    # -------------------------------------------------------------------------
    # Step 6: Other files (0666 & ~umask).
    # -------------------------------------------------------------------------
    new_permission=$(printf "%04o" "$((0666 & ~$(umask)))")
    find_args=("${items[@]}" ! -regex "$IGNORE_FIND")
    for pattern in "${sensitive_dirs[@]}"; do
        find_args+=(! -path "*/$pattern/*")
    done
    for pattern in "${sensitive_files[@]}"; do
        find_args+=(! -name "$pattern")
    done
    find_args+=(-type f -exec chmod "$new_permission" -- {} +)
    std_output=$(find "${find_args[@]}" 2>&1)
    _check_output "$?" "$std_output" "" ""
}

_main "$@"

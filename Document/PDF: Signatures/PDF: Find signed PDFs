#!/usr/bin/env bash
# install_mime_type=application/pdf;inode/directory;
# install_icon_kde=edit-find

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()

    # Execute initial checks.
    _check_dependencies "pdfinfo"
    _display_wait_box ""
    _get_files "
        par_type=file
        par_recursive=true
        par_select_extension=pdf
    " "input_files"

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "input_files" ""

    local std_output=""
    std_output=$(_storage_text_read_all)
    std_output=$(_str_sort "$std_output" "$ITEM_SEP" "false")

    # Translate some strings from the '$std_output'.
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_Valid__|$(_i18n 'Valid signature')|g" <<<"$std_output")
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_Invalid__|$(_i18n 'Invalid signature')|g" <<<"$std_output")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'files')
        par_columns='--column:$(_i18n 'Signature'),--column:$(_i18n 'File')'
        par_action=open_location
        par_check_type=checkbox
    "
}

_main_task() {
    local input_file=$1
    local std_output=""

    # Run the main process.
    std_output=$(_run_in_sandbox "" "false" \
        pdfsig -- "$input_file" 2>/dev/null)

    # Any invalid signature makes the whole file invalid.
    if [[ "$std_output" == *"Signature is Invalid"* ]]; then
        _storage_text_write "🔴 __MSG_Invalid__$COL_SEP$(_text_remove_pwd "$input_file")"
    elif [[ "$std_output" == *"Signature is Valid"* ]]; then
        _storage_text_write "🟢 __MSG_Valid__$COL_SEP$(_text_remove_pwd "$input_file")"
    fi
}

_main "$@"

#!/usr/bin/env bash
# install_mime_type=text/*;application/*;
# install_icon_kde=document-export

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _get_files "par_type=file" "input_files"

    local dependencies=""
    dependencies=$(_get_dependencies "${input_files[@]}")
    _check_dependencies "$dependencies"
    _display_wait_box ""
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    export -f _get_command _run_command

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "input_files" "$output_dir"
    _display_result_box "$output_dir"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local output_file=""
    local command=""

    # Run the main process.
    command=$(_get_command "$input_file")
    _run_command "$input_file" "$command" "$output_dir"
}

_get_dependencies() {
    local -a input_files=("$@")
    local dependencies=""

    # Check dependencies for each file.
    local input_file=""
    for input_file in "${input_files[@]}"; do
        local command=""
        command=$(_get_command "$input_file")

        case $command in
        "magick")
            if ! _command_exists "magick"; then
                dependencies+="magick"
            fi
            ;;
        "inkscape") dependencies+="inkscape" ;;
        "libreoffice_calc")
            if ! _command_exists "libreoffice.calc" &&
                ! _command_exists "localc" &&
                ! _command_exists "libreoffice-calc"; then
                dependencies+="localc"
            fi
            ;;
        "libreoffice_impress")
            if ! _command_exists "libreoffice.impress" &&
                ! _command_exists "loimpress" &&
                ! _command_exists "libreoffice-impress"; then
                dependencies+="loimpress"
            fi
            ;;
        "libreoffice_writer")
            if ! _command_exists "libreoffice.writer" &&
                ! _command_exists "lowriter" &&
                ! _command_exists "libreoffice-writer"; then
                dependencies+="lowriter"
            fi
            ;;
        "rayomd") dependencies+="rayomd" ;;
        "pandoc") dependencies+="pandoc" ;;
        esac
        dependencies+=$'\n'
    done

    printf "%s" "$dependencies"
}

_get_command() {
    local input_file=$1
    local command=""

    case "${input_file,,}" in
    *.bmp | *.gif | *.jpeg | *.jpg | *.png | *.tif | *.tiff | *.webp) command="magick" ;;
    *.doc | *.docx) command="libreoffice_writer" ;;
    *.htm | *.html) command="libreoffice_writer" ;;
    *.md | *.markdown) command="rayomd" ;;
    *.odf | *.fodf) command="libreoffice_writer" ;;
    *.odg | *.fodg) command="libreoffice_impress" ;;
    *.odp | *.fodp) command="libreoffice_impress" ;;
    *.ods | *.fods) command="libreoffice_calc" ;;
    *.odt | *.fodt) command="libreoffice_writer" ;;
    *.ppt | *.pptx) command="libreoffice_impress" ;;
    *.rtf) command="libreoffice_writer" ;;
    *.svg | *.svgz) command="inkscape" ;;
    *.txt) command="rayomd" ;;
    *.xls | *.xlsx) command="libreoffice_calc" ;;
    *) command="pandoc" ;;
    esac

    printf "%s" "$command"
}

_run_command() {
    local input_file=$1
    local command=$2
    local output_dir=$3
    local output_format="pdf"
    local output_file=""
    local std_output=""

    output_file=$(_get_output_filename "$input_file" "$output_dir" "
        par_extension_opt=replace
        par_extension=$output_format
        par_suffix='(landscape)'
    ")

    # Run the main process.
    case $command in
    "magick")
        std_output=$(_cmd_magick_in_sandbox "$output_dir" convert "$input_file" "$output_file" 2>&1)
        _check_output "$?" "$std_output" "$input_file" "$output_file" || return 1
        ;;
    "inkscape")
        std_output=$(inkscape \
            --export-area-drawing \
            --export-filename="$output_file" \
            -- "$input_file" 2>&1)
        _check_output "$?" "$std_output" "$input_file" "$output_file" || return 1
        ;;
    "libreoffice_calc" | "libreoffice_impress" | "libreoffice_writer")
        # Use a local temporary directory to work.
        local basename=""
        local temp_dir_local=""
        local temp_output_file=""
        basename=$(basename -- "$input_file")             # Remove the path.
        basename=$(_strip_filename_extension "$basename") # Remove the extension.
        temp_dir_local=$(_make_temp_dir_local "$output_dir" ".$basename") || return 1

        # HACK: Workaround for LibreOffice.
        # LibreOffice does not run if another instance is already open.
        # See: https://bugs.documentfoundation.org/show_bug.cgi?id=37531
        local temp_dir=""
        temp_dir=$(_make_temp_dir)

        # NOTE: LibreOffice does not support '--' in the command line.
        # NOTE: LibreOffice does not support defining the output file manually.
        std_output=$(libreoffice \
            --headless \
            --convert-to "$output_format" \
            "-env:UserInstallation=file://$temp_dir" \
            --outdir "$temp_dir_local" "$input_file" 2>&1)
        local exit_code=$?

        # Remove the temporary directory.
        rm -rf -- "$temp_dir"

        temp_output_file=$(find "$temp_dir_local" \
            -type f \
            -name "*.$output_format" \
            -print \
            -quit 2>/dev/null)
        _move_file "skip" "$temp_output_file" "$output_file"

        # Remove the temporary directory (local directory).
        rm -rf -- "$temp_dir_local"

        _check_output "$exit_code" "$std_output" "$input_file" "$output_file" || return 1
        ;;
    "rayomd")
        std_output=$(_run_in_sandbox "$output_dir" "false" \
            rayomd --export "$input_file" "$output_file" \
            --page-size=a4-landscape --page-numbers 2>&1)
        _check_output "$?" "$std_output" "$input_file" "$output_file" || return 1
        ;;
    "pandoc")
        std_output=$(_run_in_sandbox "$output_dir" "false" \
            pandoc -V "geometry:a4paper,landscape,margin=1.5cm" \
            --standalone -o "$output_file" -- "$input_file" 2>&1)
        _check_output "$?" "$std_output" "$input_file" "$output_file" || return 1
        ;;
    esac
}

_main "$@"

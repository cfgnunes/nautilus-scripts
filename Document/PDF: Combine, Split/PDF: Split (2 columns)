#!/usr/bin/env bash
# install_mime_type=application/pdf;
# install_icon_kde=split

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "pdfcpu"
    _display_wait_box ""
    _get_files "par_type=file; par_select_extension=pdf" "input_files"
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "input_files" "$output_dir"
    _display_result_box "$output_dir"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local output_file=""
    local std_output=""

    output_file=$(_get_output_filename "$input_file" "$output_dir" \
        "par_extension_opt=preserve; par_suffix='(2 columns)'")

    local temp_dir=""
    temp_dir="$(_make_temp_dir)"

    # Run the main process.
    # Split the PDF file.
    std_output=$(_run_in_sandbox "$output_dir" "false" \
        pdfcpu cut 'vert:.5' "$input_file" "$temp_dir" "out" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # Remove the first page from each PDF file in the temporary directory.
    local file=""
    for file in "$temp_dir"/*.pdf; do
        std_output=$(_run_in_sandbox "$output_dir" "false" \
            pdfcpu pages remove -p 1 "$file" 2>&1)
        _check_output "$?" "$std_output" "$file" "" || return 1
    done

    # Merge the PDF files in the temporary directory into a single output file.
    local -a parts=()
    IFS=$'\n' read -r -d '' -a parts < <(find "$temp_dir" -type f 2>/dev/null |
        LC_ALL=C.UTF-8 sort --version-sort) || true
    std_output=$(_run_in_sandbox "$output_dir" "false" \
        pdfcpu merge "$output_file" "${parts[@]}" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "$output_file" || return 1

    # Remove the temporary directory.
    rm -rf -- "$temp_dir"
}

_main "$@"

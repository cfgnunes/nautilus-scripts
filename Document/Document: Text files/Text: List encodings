#!/usr/bin/env bash
# install_mime_type=text/plain;inode/directory;
# install_icon_kde=view-sort-descending

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _display_wait_box ""
    _get_files "
        par_type=file
        par_recursive=true
        par_skip_extension='pdf|svg'
    " "input_files"

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "input_files" "$output_dir"

    local std_output=""
    std_output=$(_storage_text_read_all)
    std_output=$(_str_sort "$std_output" "$ITEM_SEP" "false")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'files')
        par_columns='--column:$(_i18n 'Encoding'),--column:$(_i18n 'File')'
        par_action=open_location
        par_check_type=checkbox
    "
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""
    local file_encoding=""
    file_encoding=$(_get_file_encoding "$input_file")

    if [[ -z "$file_encoding" || "$file_encoding" == "binary" ]]; then
        return
    fi

    # Run the main process.
    std_output="$file_encoding$COL_SEP$input_file"
    std_output=$(_text_remove_pwd "$std_output")

    _storage_text_write "$std_output"
}

_main "$@"

#!/usr/bin/env bash
# install_icon_kde=archive-insert

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    if ! _command_exists "bsdtar"; then
        _check_dependencies "7za"
    fi
    _display_wait_box ""
    input_files=$(_get_files "par_type=all")

    TASK_PASSWORD=$(_display_password_box_define) || _exit_script
    export TASK_PASSWORD

    # Check output directory only after displaying dialog boxes to the user.
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$input_files" "$output_dir"
    _display_result_box "$output_dir"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local output_file=""
    local std_output=""
    local work_dir=""
    local item=""
    local -a bsdtar_opts=()

    __cmd_7z() {
        if _command_exists "7z"; then
            _run_in_sandbox "$output_dir" "false" 7z "$@"
        elif _command_exists "7za"; then
            _run_in_sandbox "$output_dir" "false" 7za "$@"
        else
            _run_in_sandbox "$output_dir" "false" \
                "$(compgen -c 7z | head -n 1)" "$@"
        fi
    }

    output_file=$(_get_output_filename "$input_file" "$output_dir" \
        "par_extension_opt=replace; par_extension=zip")

    if [[ -d "$input_file" ]]; then
        if _is_directory_empty "$input_file"; then
            _log_error "The directory is empty." "$input_file" "" "$output_file"
            return 1
        fi
        # Archive the directory contents without the parent directory.
        work_dir=$input_file
        item="."
        bsdtar_opts=(--strip-components 1)
    else
        # Archive the file without the parent directory.
        work_dir=$(_get_dirname "$input_file")
        item=$(basename -- "$input_file")
    fi

    # Run the main process.
    _directory_push "$work_dir" || return 1
    if compgen -c 7z &>/dev/null; then
        std_output=$(__cmd_7z a -snl -mem=AES256 -p"$TASK_PASSWORD" \
            "$output_file" -- "$item" 2>&1)
    elif _command_exists "bsdtar"; then
        std_output=$(_run_in_sandbox "$output_dir" "false" \
            bsdtar "${bsdtar_opts[@]}" -a -c \
            --passphrase "$TASK_PASSWORD" --options zip:encryption=aes256 \
            -f "$output_file" -- "$item" 2>&1)
    else
        _log_error "No compatible command found." "$input_file" "" "$output_file"
        return 1
    fi
    _check_output "$?" "$std_output" "$input_file" "$output_file" || return 1

    _directory_pop || return 1

    # HACK: Workaround for GNOME Files (Nautilus).
    # The file manager sometimes fails to recognize newly created zip
    # files immediately. The user needs to refresh the view to see them.
    touch --no-create -- "$output_file"
}

_main "$@"

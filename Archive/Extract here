#!/usr/bin/env bash
# install_mime_type=all/allfiles;
# install_icon_kde=archive-extract
# install_keyboard_shortcut=<Control>E

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    input_files=$(_get_files "par_type=file")
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    # Default password for testing encrypted archives.
    TASK_PASSWORD="null"
    export TASK_PASSWORD

    # Execute the function '_get_dependencies' for each file in parallel.
    export -f \
        _all_commands_exist \
        _concat_file \
        _get_command \
        _get_dependencies \
        _run_command \
        _strip_filename_multipart
    _run_function_parallel "$input_files" "$FIELD_SEPARATOR" "" \
        "_get_dependencies"

    local dependencies=""
    dependencies=$(_storage_text_read_all)

    _check_dependencies "$dependencies"
    _display_wait_box ""

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$input_files" "$output_dir"
    _display_result_box ""
}

_main_task() {
    local input_file=$1
    local output_dir=$2

    # Run the main process.
    local command=""
    command=$(_get_command "$input_file" "available")
    _run_command "$input_file" "$command" "$output_dir"
}

# Function: _strip_filename_multipart
#
# Description:
#   This function removes the split archive suffixes ('.000', '.001', and
#   '.part') from a filename.
#
# Parameters:
#   $1 (filename): The filename to be processed.
#
# Returns:
#   The filename without the split archive suffixes (printed to stdout).
_strip_filename_multipart() {
    local filename=$1

    # Remove the number ('.000', '.001') suffixes.
    if [[ "$filename" =~ \.[0-9]+$ ]]; then
        filename=${filename%.*}
        # Remove the '.part' suffix if it exists.
        if [[ "${filename,,}" =~ \.part$ ]]; then
            filename=${filename%.*}
        fi
    fi
    printf "%s" "$filename"
}

# Function: _concat_file
#
# Description:
#   This function joins the parts of a split archive (for example, 'file.001'
#   and 'file.002') into a single file in the output directory.
#
# Parameters:
#   $1 (input_file): Any part of the split archive.
#   $2 (output_dir): The directory where the joined file will be created.
#
# Returns:
#   The path of the joined file (printed to stdout).
_concat_file() {
    local input_file=$1
    local output_dir=$2
    local base_file=${input_file%.*}
    local extension=${input_file##*.}
    local output_file=""
    local output_file_path=""
    local part=""
    local -a parts=()

    # Turn the extension into a glob with the same number of digits.
    # Example: '001' -> '[0-9][0-9][0-9]'.
    local digits_glob=${extension//[0-9]/[0-9]}

    for part in "$base_file".$digits_glob; do
        [[ -f "$part" ]] && parts+=("$part")
    done
    [[ ${#parts[@]} -gt 0 ]] || return 1

    output_file=$(basename -- "$input_file")
    output_file=$(_strip_filename_multipart "$output_file")
    output_file_path="$output_dir/$output_file"

    cat -- "${parts[@]}" >"$output_file_path" || return 1
    printf "%s" "$output_file_path"
}
# Function: _get_dependencies
#
# Description:
#   This function checks if the extraction command for a file is available. If
#   it is not, the default command is written to the text storage so it can be
#   reported to the user.
#
# Parameters:
#   $1 (input_file): The archive file to be checked.
_get_dependencies() {
    local input_file=$1

    local command=""
    command=$(_get_command "$input_file" "available")

    # If there is an available command, skip the dependency.
    if [[ -n "$command" ]]; then
        return
    fi

    command=$(_get_command "$input_file" "default")

    _storage_text_write_ln "$command"
}

# Function: _get_command
#
# Description:
#   This function determines the command used to extract an archive, based on
#   its filename extension or, if the extension is unknown, its MIME type.
#
# Parameters:
#   $1 (input_file): The archive file.
#   $2 (command_status): 'default' to get the first preferred command, or
#      'available' to get the first preferred command installed on the system.
#
# Returns:
#   The name of the command (printed to stdout).
_get_command() {
    local input_file=$1
    local command_status=$2
    local command=""

    # -------------------------------------------------------------------------
    # SECTION: Define the preferred commands, types and extension
    # -------------------------------------------------------------------------

    # NOTE: The tables are declared inside the function because associative
    # arrays cannot be exported to the parallel subshells ('export -f').

    # Preferred commands for each archive type, in order of preference.
    # Composite commands (all must be installed) are joined by commas.
    # Format: ["type"]="cmd1 cmd2"
    local -A cmds_by_type=(
        ["7za"]="7za bsdtar"
        ["ar"]="ar bsdtar"
        ["arj"]="7za"
        ["bz"]="bzip2 7za"
        ["bz3"]="bzip3"
        ["br"]="brotli"
        ["cab"]="cabextract bsdtar"
        ["cpio"]="cpio bsdtar"
        ["dar"]="dar"
        ["deb"]="ar"
        ["gpg"]="gpg"
        ["gz"]="gzip 7za"
        ["iso"]="xorriso bsdtar"
        ["lrz"]="lrzip"
        ["lz"]="lzip"
        ["lz4"]="lz4"
        ["lzh"]="lha"
        ["lzma"]="xz"
        ["lzo"]="lzop"
        ["msi"]="7za"
        ["rar"]="unrar bsdtar"
        ["rpm"]="bsdtar"
        ["rz"]="rzip"
        ["sqsh"]="unsquashfs rdsquashfs"
        ["tar"]="tar bsdtar 7za"
        ["tar_7z"]="tar,7za"
        ["tar_br"]="tar,brotli"
        ["tar_bz"]="tar,bzip2 7za"
        ["tar_bz3"]="tar,bzip3"
        ["tar_gz"]="tar,gzip 7za"
        ["tar_lrz"]="tar,lrzip"
        ["tar_lz"]="tar,lzip"
        ["tar_lz4"]="tar,lz4"
        ["tar_lzma"]="tar,lzma 7za"
        ["tar_lzo"]="tar,lzop"
        ["tar_rz"]="tar,rzip"
        ["tar_xz"]="tar,xz 7za"
        ["tar_z"]="tar,gzip 7za"
        ["tar_zst"]="tar,zstd"
        ["unknown"]="bsdtar,7za"
        ["xar"]="bsdtar"
        ["xz"]="xz 7za"
        ["z"]="gzip"
        ["zip"]="7za bsdtar"
        ["zpaq"]="zpaq"
        ["zstd"]="zstd"
    )

    # Archive type for each filename extension (lowercase).
    # Format: ["ext"]="type"
    local -A type_by_ext=(
        ["7z"]="7za"
        ["apk"]="zip"
        ["ar"]="ar"
        ["arj"]="arj"
        ["asc"]="gpg"
        ["br"]="br"
        ["bz"]="bz"
        ["bz2"]="bz"
        ["bz3"]="bz3"
        ["cab"]="cab"
        ["cbr"]="rar"
        ["cbz"]="zip"
        ["cpio"]="cpio"
        ["crx"]="zip"
        ["dar"]="dar"
        ["deb"]="deb"
        ["dmg"]="7za"
        ["ear"]="zip"
        ["epub"]="zip"
        ["exe"]="7za"
        ["gem"]="tar"
        ["gpg"]="gpg"
        ["gtar"]="tar"
        ["gz"]="gz"
        ["iso"]="iso"
        ["jar"]="zip"
        ["lha"]="lzh"
        ["lrz"]="lrz"
        ["lz"]="lz"
        ["lz4"]="lz4"
        ["lzh"]="lzh"
        ["lzma"]="lzma"
        ["lzo"]="lzo"
        ["lzs"]="lzh"
        ["msi"]="msi"
        ["pgp"]="gpg"
        ["rar"]="rar"
        ["rpm"]="rpm"
        ["rz"]="rz"
        ["sfs"]="sqsh"
        ["snap"]="sqsh"
        ["sqsh"]="sqsh"
        ["squashfs"]="sqsh"
        ["svgz"]="gz"
        ["tar"]="tar"
        ["tar.7z"]="tar_7z"
        ["tar.br"]="tar_br"
        ["tar.bz"]="tar_bz"
        ["tar.bz2"]="tar_bz"
        ["tar.bz3"]="tar_bz3"
        ["tar.gz"]="tar_gz"
        ["tar.lrz"]="tar_lrz"
        ["tar.lz"]="tar_lz"
        ["tar.lz4"]="tar_lz4"
        ["tar.lzma"]="tar_lzma"
        ["tar.lzo"]="tar_lzo"
        ["tar.rz"]="tar_rz"
        ["tar.xz"]="tar_xz"
        ["tar.z"]="tar_z"
        ["tar.zst"]="tar_zst"
        ["taz"]="tar_z"
        ["tb2"]="tar_bz"
        ["tbz"]="tar_bz"
        ["tbz2"]="tar_bz"
        ["tbz3"]="tar_bz3"
        ["tgz"]="tar_gz"
        ["tlrz"]="tar_lrz"
        ["tlz"]="tar_lzma"
        ["txz"]="tar_xz"
        ["tzo"]="tar_lzo"
        ["tzst"]="tar_zst"
        ["udeb"]="deb"
        ["vgz"]="gz"
        ["war"]="zip"
        ["wim"]="7za"
        ["xar"]="xar"
        ["xz"]="xz"
        ["z"]="z"
        ["zip"]="zip"
        ["zipx"]="zip"
        ["zpaq"]="zpaq"
        ["zst"]="zstd"
    )

    # Archive type for each MIME type (lowercase).
    # Format: ["mime"]="type"
    # NOTE: See the file: /usr/share/mime/packages/freedesktop.org.xml
    local -A type_by_mime=(
        ["application/bzip2"]="bz"
        ["application/epub+zip"]="zip"
        ["application/gzip"]="gz"
        ["application/java-archive"]="zip"
        ["application/pgp-encrypted"]="gpg"
        ["application/vnd.android.package-archive"]="zip"
        ["application/vnd.debian.binary-package"]="deb"
        ["application/vnd.ms-cab-compressed"]="cab"
        ["application/vnd.rar"]="rar"
        ["application/vnd.snap"]="sqsh"
        ["application/vnd.squashfs"]="sqsh"
        ["application/x-7z-compressed"]="7za"
        ["application/x-7z-compressed-tar"]="tar_7z"
        ["application/x-apple-diskimage"]="7za"
        ["application/x-archive"]="ar"
        ["application/x-arj"]="arj"
        ["application/x-brotli"]="br"
        ["application/x-brotli-compressed-tar"]="tar_br"
        ["application/x-bzip"]="bz"
        ["application/x-bzip-compressed-tar"]="tar_bz"
        ["application/x-bzip1"]="bz"
        ["application/x-bzip1-compressed-tar"]="tar_bz"
        ["application/x-bzip2"]="bz"
        ["application/x-bzip3"]="bz3"
        ["application/x-bzip3-compressed-tar"]="tar_bz3"
        ["application/x-cabinet"]="cab"
        ["application/x-cbr"]="rar"
        ["application/x-cbz"]="zip"
        ["application/x-cd-image"]="iso"
        ["application/x-chrome-extension"]="zip"
        ["application/x-compress"]="z"
        ["application/x-compressed-tar"]="tar_gz"
        ["application/x-cpio"]="cpio"
        ["application/x-dar"]="dar"
        ["application/x-deb"]="deb"
        ["application/x-debian-package"]="deb"
        ["application/x-ear"]="zip"
        ["application/x-gtar"]="tar"
        ["application/x-gzip"]="gz"
        ["application/x-iso9660-image"]="iso"
        ["application/x-java-archive"]="zip"
        ["application/x-lha"]="lzh"
        ["application/x-lhz"]="lzh"
        ["application/x-lrzip"]="lrz"
        ["application/x-lrzip-compressed-tar"]="tar_lrz"
        ["application/x-lz4"]="lz4"
        ["application/x-lz4-compressed-tar"]="tar_lz4"
        ["application/x-lzh-compressed"]="lzh"
        ["application/x-lzip"]="lz"
        ["application/x-lzip-compressed-tar"]="tar_lz"
        ["application/x-lzma"]="lzma"
        ["application/x-lzma-compressed-tar"]="tar_lzma"
        ["application/x-lzop"]="lzo"
        ["application/x-modrinth-modpack+zip"]="zip"
        ["application/x-ms-wim"]="7za"
        ["application/x-msi"]="msi"
        ["application/x-rar"]="rar"
        ["application/x-rar-compressed"]="rar"
        ["application/x-raw-disk-image-xz-compressed"]="xz"
        ["application/x-rpm"]="rpm"
        ["application/x-rzip"]="rz"
        ["application/x-rzip-compressed-tar"]="tar_rz"
        ["application/x-source-rpm"]="rpm"
        ["application/x-tar"]="tar"
        ["application/x-tarz"]="tar_z"
        ["application/x-tzo"]="tar_lzo"
        ["application/x-war"]="zip"
        ["application/x-xar"]="xar"
        ["application/x-xz"]="xz"
        ["application/x-xz-compressed-tar"]="tar_xz"
        ["application/x-zip"]="zip"
        ["application/x-zip-compressed"]="zip"
        ["application/x-zstd-compressed-tar"]="tar_zst"
        ["application/zip"]="zip"
        ["application/zstd"]="zstd"
        ["image/svg+xml-compressed"]="gz"
    )

    # -------------------------------------------------------------------------
    # SECTION: Detect the archive type
    # -------------------------------------------------------------------------
    local archive_type=""

    # For split archives ('.000' or '.001'), use the name of the joined file.
    local type_name=""
    type_name=$(_strip_filename_multipart "$input_file")
    type_name=${type_name##*/}
    type_name=${type_name,,}

    # Determine the archive type based on the filename extension. Try the
    # longest extension first (for example, 'tar.gz' before 'gz').
    local extension=$type_name
    while [[ "$extension" == *.* ]]; do
        extension=${extension#*.}
        if [[ -n "$extension" ]] && [[ -n "${type_by_ext[$extension]+set}" ]]; then
            archive_type=${type_by_ext[$extension]}
            break
        fi
    done

    # For unknown extension, determine the archive type based on the MIME type.
    if [[ -z "$archive_type" ]]; then
        local file_mime=""
        file_mime=$(_get_file_mime "$input_file")
        file_mime=${file_mime,,}

        if [[ -n "$file_mime" ]] && [[ -n "${type_by_mime[$file_mime]+set}" ]]; then
            archive_type=${type_by_mime[$file_mime]}
        elif [[ "$file_mime" == "application/octet-stream" ]]; then
            # For generic binary files, try further identification.
            local file_information=""
            file_information=$(LC_ALL=C.UTF-8 file --dereference --brief \
                -- "$input_file" 2>/dev/null)
            case "${file_information,,}" in
            "gpg "* | "pgp "*) archive_type="gpg" ;;
            esac
        fi
    fi

    # Default extractor chain for unknown files.
    if [[ -z "$archive_type" ]]; then
        archive_type="unknown"
    fi

    local -a pref_cmds=()
    IFS=" " read -r -a pref_cmds <<<"${cmds_by_type[$archive_type]}"

    # -------------------------------------------------------------------------
    # SECTION: Select the command
    # -------------------------------------------------------------------------

    # Determine the command to use based on the command status.
    if [[ "$command_status" == "default" ]]; then
        # Use the first preferred command as the default.
        command=${pref_cmds[0]}
    elif [[ "$command_status" == "available" ]]; then
        # Find the first available command on the system.
        local pref_command=""
        for pref_command in "${pref_cmds[@]}"; do
            if [[ "$pref_command" == *","* ]]; then
                # Check if all commands in a composite command exist.
                if _all_commands_exist "${pref_command//,/ }"; then
                    command=$pref_command
                    break
                fi
            elif _command_exists "$pref_command"; then
                # Use the first available command.
                command=$pref_command
                break
            fi
        done
    fi

    printf "%s" "$command"
}

# Function: _all_commands_exist
#
# Description:
#   This function checks if all commands of a list exist on the system.
#
# Parameters:
#   $1 (commands): A space-separated list of command names.
#
# Returns:
#   0 (true): If all commands exist.
#   1 (false): If any command does not exist.
_all_commands_exist() {
    local commands=$1

    local -a cmd_array=()
    IFS=" " read -r -a cmd_array <<<"$commands"

    local command=""
    for command in "${cmd_array[@]}"; do
        if ! _command_exists "$command"; then
            return 1
        fi
    done
    return 0
}

# Function: _run_command
#
# Description:
#   This function extracts an archive using the given command. If the archive
#   is password protected, it asks the user for the password and tries again.
#   The extracted items are moved to the output directory.
#
# Parameters:
#   $1 (input_file): The archive file to be extracted.
#   $2 (command): The command used to extract the archive.
#   $3 (output_dir): The directory where the extracted items will be placed.
#      If empty, the directory of the input file is used.
#
# Returns:
#   0 (true): If the archive was extracted successfully.
#   1 (false): If the extraction failed or no items were extracted.
_run_command() {
    local input_file=$1
    local command=$2
    local output_dir=$3
    local exit_code=0
    local basename=""
    local filename=""
    local password=""
    local std_output=""
    local temp_dir_extract=""
    local temp_dir_extract_cat=""

    # -------------------------------------------------------------------------
    # SECTION: Prepare the paths
    # -------------------------------------------------------------------------

    if [[ -z "$output_dir" ]]; then
        output_dir=$(dirname -- "$input_file")
    fi

    basename=$(basename -- "$input_file")
    filename="$basename"
    filename=$(_strip_filename_multipart "$filename")
    filename=$(_strip_filename_extension "$filename")

    # -------------------------------------------------------------------------
    # SECTION: Helper functions
    # -------------------------------------------------------------------------

    __sandbox() {
        _run_in_sandbox "$output_dir" "false" "$@"
    }
    # Run '<producer> | tar xf -' and fail if either side fails. The stderr of
    # both commands is merged into the output.
    __pipe_to_tar() {
        (
            set -o pipefail
            "$@" | __sandbox tar xf -
        ) 2>&1
    }
    __cmd_7z() {
        if _command_exists "7z"; then
            __sandbox 7z "$@"
        elif _command_exists "7za"; then
            __sandbox 7za "$@"
        else
            __sandbox "$(compgen -c 7z | head -n 1)" "$@"
        fi
    }
    __get_password() {
        # Remove only the extraction directory. The directory with the joined
        # file ('temp_dir_extract_cat') is still needed for the next attempt.
        __temp_dir_pop && __temp_dir_extract_remove
        password=$(_display_password_box "$(_i18n 'Enter the password for the archive:') '$basename'") || {
            __temp_dir_remove
            return 1
        }
        __temp_dir_push || return 1
    }
    __get_saved_filename() {
        local saved_filename=""
        saved_filename=$(__sandbox "$1" -l -N "$input_file" 2>/dev/null |
            tail -n 1 | cut -d "%" -f 2- | sed "s|^ ||")
        if [[ -n "$saved_filename" ]] &&
            [[ "$saved_filename" != "$input_file" ]]; then
            filename=$(basename "$saved_filename")
        fi
    }
    __temp_dir_push() {
        temp_dir_extract=$(_make_temp_dir_local "$output_dir" "$filename") || return 1
        _directory_push "$temp_dir_extract" || return 1
    }
    __temp_dir_pop() {
        _directory_pop || return 1
    }
    __temp_dir_extract_remove() {
        if [[ -d "$temp_dir_extract" ]]; then
            rm -rf -- "$temp_dir_extract" 2>/dev/null
        fi
    }
    __temp_dir_remove() {
        local dir=""
        for dir in "$temp_dir_extract" "$temp_dir_extract_cat"; do
            if [[ -d "$dir" ]]; then
                rm -rf -- "$dir" 2>/dev/null
            fi
        done
    }

    # -------------------------------------------------------------------------
    # SECTION: Prepare the input file
    # -------------------------------------------------------------------------

    # Ensure the input file has an absolute path before proceeding.
    if [[ $input_file != "/"* ]]; then
        input_file=$(readlink -f "$input_file")
    fi

    # For split archives ('.000' or '.001'), join the parts into a temporary
    # file and extract the joined file.
    if [[ "$input_file" =~ \.[0-9]+$ ]]; then
        temp_dir_extract_cat=$(_make_temp_dir_local "$output_dir" "$filename") || return 1
        input_file=$(_concat_file "$input_file" "$temp_dir_extract_cat") || return 1
    fi

    # -------------------------------------------------------------------------
    # SECTION: Extract the archive
    # -------------------------------------------------------------------------

    # Use a local temporary directory to work.
    __temp_dir_push || return 1

    case "$command" in
    "7za")
        std_output=$(__cmd_7z x -aoa -p"$TASK_PASSWORD" -- "$input_file" 2>&1)
        exit_code=$?

        if ((exit_code != 0)) && grep --quiet --ignore-case "wrong password" <<<"$std_output"; then
            __get_password || return 1
            std_output=$(__cmd_7z x -aoa -p"$password" -- "$input_file" 2>&1)
            exit_code=$?
        fi
        ;;
    "ar")
        std_output=$(__sandbox ar x -- "$input_file" 2>&1)
        exit_code=$?
        ;;
    "bsdtar")
        std_output=$(__sandbox bsdtar --passphrase "$TASK_PASSWORD" -xf "$input_file" 2>&1)
        exit_code=$?

        if ((exit_code != 0)) && grep --quiet --ignore-case "incorrect passphrase" <<<"$std_output"; then
            __get_password || return 1
            std_output=$(__sandbox bsdtar --passphrase "$password" -xf "$input_file" 2>&1)
            exit_code=$?
        fi
        ;;
    "bzip2" | "bzip3" | "brotli" | "gzip" | "lz4" | "lzip" | "lzop" | "xz" | "zstd")
        # Get the original filename stored in the archive, if available.
        if [[ "$command" == "gzip" || "$command" == "lzop" ]]; then
            __get_saved_filename "$command"
        fi
        __sandbox "$command" -d -c -- "$input_file" >"$filename" 2>/dev/null
        exit_code=$?
        ;;
    "cabextract")
        std_output=$(__sandbox cabextract "$input_file" 2>&1)
        exit_code=$?
        ;;
    "cpio")
        std_output=$(__sandbox cpio -idv <"$input_file" 2>&1)
        exit_code=$?
        ;;
    "dar")
        std_output=$(__sandbox dar -x "$input_file" 2>&1)
        exit_code=$?
        ;;
    "gpg")
        std_output=$(gpg --batch --yes --decrypt --output "$filename" -- "$input_file" 2>&1)
        exit_code=$?
        local file_mime=""
        file_mime=$(_get_file_mime "$filename")
        if ((exit_code == 0)) && [[ "$file_mime" == "application/x-tar" ]]; then
            # Create a temporary local directory for extraction.
            local temp_dir_extract_tar=""
            temp_dir_extract_tar=$(_make_temp_dir_local "$output_dir" "$filename") || return 1
            mv -- "$filename" "$temp_dir_extract_tar/$filename"
            std_output=$(__sandbox tar --extract --file="$temp_dir_extract_tar/$filename" 2>&1)
            exit_code=$?
            # Remove the temporary directory (local directory).
            rm -rf -- "$temp_dir_extract_tar"
        fi
        ;;
    "lha")
        std_output=$(__sandbox lha -e "$input_file" 2>&1)
        exit_code=$?
        ;;
    "lrzip")
        std_output=$(__sandbox lrzip -d -o "$temp_dir_extract/$filename" -- "$input_file" 2>&1)
        exit_code=$?
        ;;
    "rdsquashfs")
        std_output=$(__sandbox rdsquashfs -u . -- "$input_file" 2>&1)
        exit_code=$?
        ;;
    "rzip")
        __sandbox rzip -d -k -o "$filename" -- "$input_file" >/dev/null 2>&1
        exit_code=$?
        ;;
    "tar,7za")
        std_output=$(__pipe_to_tar __cmd_7z x -so -- "$input_file")
        exit_code=$?
        ;;
    "tar,brotli")
        std_output=$(__pipe_to_tar __sandbox brotli -d -c -- "$input_file")
        exit_code=$?
        ;;
    "tar,bzip3")
        std_output=$(__pipe_to_tar __sandbox bzip3 -d -c -- "$input_file")
        exit_code=$?
        ;;
    "tar,rzip")
        std_output=$(__sandbox rzip -d -k -o "$temp_dir_extract/.tmp.tar" -- "$input_file" 2>&1 &&
            __sandbox tar --extract --file="$temp_dir_extract/.tmp.tar" 2>&1)
        exit_code=$?
        rm -f -- "$temp_dir_extract/.tmp.tar"
        ;;
    "tar,bzip2" | "tar,gzip" | "tar,lzip" | "tar,lzma" | "tar,lzop" | "tar,xz")
        # The compressor name is also the long option of 'tar'.
        std_output=$(__sandbox tar --extract "--${command#tar,}" --file="$input_file" 2>&1)
        exit_code=$?
        ;;
    "tar,lrzip")
        std_output=$(__sandbox lrztar -d "$input_file" 2>&1)
        exit_code=$?
        ;;
    "tar,lz4")
        std_output=$(__pipe_to_tar __sandbox lz4 -d -c -- "$input_file")
        exit_code=$?
        ;;
    "tar,zstd")
        std_output=$(__pipe_to_tar __sandbox zstd -f -d -c -- "$input_file")
        exit_code=$?
        ;;
    "tar")
        std_output=$(__sandbox tar --extract --file="$input_file" 2>&1)
        exit_code=$?
        ;;
    "unrar")
        std_output=$(__sandbox unrar x -p"$TASK_PASSWORD" -- "$input_file" 2>&1)
        exit_code=$?

        if ((exit_code != 0)) && grep --quiet --ignore-case "password" <<<"$std_output"; then
            __get_password || return 1
            std_output=$(__sandbox unrar x -p"$password" -- "$input_file" 2>&1)
            exit_code=$?
        fi
        ;;
    "unsquashfs")
        std_output=$(__sandbox unsquashfs "$input_file" 2>&1)
        exit_code=$?
        ;;
    "xorriso")
        std_output=$(__sandbox xorriso -osirrox on -indev "$input_file" -- -extract / . -rollback_end 2>&1)
        exit_code=$?
        ;;
    "zpaq")
        std_output=$(__sandbox zpaq x "$input_file" 2>&1)
        exit_code=$?
        ;;
    "bsdtar,7za")
        # Default extractor chain for unrecognized files.
        # Try to extract with 'bsdtar'.
        std_output=$(__sandbox bsdtar -xf "$input_file" 2>&1)
        exit_code=$?
        # Try to extract with '7za'.
        if ((exit_code != 0)); then
            std_output=$(__cmd_7z x -aoa -- "$input_file" 2>&1)
            exit_code=$?
        fi

        if ((exit_code != 0)); then
            std_output="Could not recognize the archive format."
        fi
        ;;
    esac

    # -------------------------------------------------------------------------
    # SECTION: Check the extraction
    # -------------------------------------------------------------------------

    # Check for result errors.
    if ((exit_code != 0)); then
        _check_output "1" "$std_output" "$input_file" ""

        # If all extracted files have zero bytes, then abort.
        local non_zero_files=""
        non_zero_files=$(find . -type f ! -size 0 2>/dev/null)
        if [[ -z "$non_zero_files" ]]; then
            __temp_dir_pop && __temp_dir_remove
            return 1
        fi
    fi

    # -------------------------------------------------------------------------
    # SECTION: Inspect the extracted items
    # -------------------------------------------------------------------------

    # Fix permissions of extracted files in 'iso' archive format.
    if [[ "${input_file,,}" == *".iso" ]]; then
        chmod --recursive u+rw -- .
    fi

    # Get the list of root items (files or directories)
    # in the 'temp_dir_extract' directory.
    local -a root_items=()
    shopt -s nullglob dotglob
    root_items=(*)
    shopt -u nullglob dotglob

    # Count the number of items.
    local count_root_items=${#root_items[@]}

    # Check if the 'temp_dir_extract' has just one item.
    local single_root_item=""
    if ((count_root_items == 1)); then
        single_root_item="${root_items[0]}"
    fi

    # Check if the 'temp_dir_extract' is empty.
    if ((count_root_items == 0)); then
        __temp_dir_pop && __temp_dir_remove
        return 1
    fi

    __temp_dir_pop || return 1

    # -------------------------------------------------------------------------
    # SECTION: Move the extracted items
    # -------------------------------------------------------------------------

    # Move the items to the correct directory.
    if [[ "$single_root_item" == "$filename" ]] ||
        [[ "$(_strip_filename_extension "$single_root_item")" == "$filename" ]]; then
        # For archives with "one item with the same name of the archive".
        # For example: 'README.txt.tar.gz' or 'README.tar.gz'.
        _move_file "rename" "$temp_dir_extract/$single_root_item" "$output_dir/$single_root_item"
    elif [[ "$single_root_item" == "squashfs-root" ]] &&
        [[ "$command" == "unsquashfs" ]]; then
        # For the 'squashfs' archive format.
        _move_file "rename" "$temp_dir_extract/$single_root_item" "$output_dir/$filename"
    else
        # For archives with "one item with a different name of the archive"
        # or "multiple items".
        _move_file "rename" "$temp_dir_extract" "$output_dir/$filename"
    fi

    __temp_dir_remove
}

_main "$@"

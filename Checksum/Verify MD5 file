#!/usr/bin/env bash
# install_mime_type=text/plain;
# install_icon_kde=checkmark

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""

    # Execute initial checks.
    _display_wait_box ""
    input_files=$(_get_files "
        par_type=file
        par_max_items=1
        par_select_mime=text/plain
    ")

    # Read the lines of the checksum file, ignoring CRLF, empty lines and comments.
    local lines=""
    lines=$(tr -d '\r' <"$input_files" | grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' || true)

    # Resolve relative paths against the directory of the checksum file.
    cd -- "$(dirname -- "$input_files")" || return 1

    # Execute the function '_verify_checksum' for each line in parallel.
    export -f _verify_checksum
    _run_function_parallel "$lines" "\n" "" "_verify_checksum"

    local std_output=""
    std_output=$(_storage_text_read_all)
    std_output=$(_text_sort "$std_output")

    # Translate some strings from the '$std_output'.
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_OK__|$(_i18n 'OK')|g" <<<"$std_output")
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_Mismatch__|$(_i18n 'Checksum error')|g" <<<"$std_output")
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_NotFound__|$(_i18n 'File does not exist')|g" <<<"$std_output")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'files')
        par_columns='--column:$(_i18n 'Status'),--column:$(_i18n 'File')'
        par_action=open_location
        par_check_type=checkbox
    "
}

_verify_checksum() {
    local line=$1
    local saved_checksum=""
    local saved_file=""
    local saved_file_decoded=""
    local current_checksum=""

    # Line format: 'hash file' (text mode) or 'hash *file' (binary mode).
    local regex='^([^ ]+) [ *](.*)$'
    if [[ "$line" =~ $regex ]]; then
        saved_checksum=${BASH_REMATCH[1]}
        saved_file=${BASH_REMATCH[2]}
    else
        saved_file=$line
    fi
    saved_file_decoded=$saved_file

    # A checksum starting with '\' indicates an escaped filename (with '\n' or
    # '\\'). Decode only in this case.
    if [[ "$saved_checksum" == \\* ]]; then
        saved_checksum=${saved_checksum#\\}
        # Use a separate variable with '%' escaped for 'printf'.
        local format=${saved_file//%/%%}
        # shellcheck disable=SC2059
        saved_file_decoded=$(printf -- "$format")
    fi

    # If the checksum is invalid or the file does not exist, report and skip.
    if [[ -z "$saved_checksum" || ! -e "$saved_file_decoded" ]]; then
        _storage_text_write_ln "🔴 __MSG_NotFound__$FIELD_SEPARATOR$saved_file"
        return 1
    fi

    # Run the main process.
    current_checksum=$(md5sum -- "$saved_file_decoded" 2>/dev/null | cut -d " " -f1)

    # Compare the checksum.
    if [[ "${saved_checksum,,}" != "${current_checksum,,}" ]]; then
        _storage_text_write_ln "🔴 __MSG_Mismatch__$FIELD_SEPARATOR$saved_file"
        return 1
    fi

    _storage_text_write_ln "🟢 __MSG_OK__$FIELD_SEPARATOR$saved_file"
}

_main "$@"

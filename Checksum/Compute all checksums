#!/usr/bin/env bash
# install_keyboard_shortcut=<Control><Shift>H
# install_icon_kde=view-barcode-qr

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "rhash"
    _display_wait_box ""
    _get_files "par_type=file; par_recursive=true" "input_files"

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "input_files" "$output_dir"

    local std_output=""
    std_output=$(_storage_text_read_all)
    std_output=$(tr "$ITEM_SEP" "\n" <<<"$std_output")

    # Translate some strings from the '$std_output'.
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_File__|$(_i18n 'File')|g" <<<"$std_output")

    _display_text_box "$std_output" "Checksums.txt"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""
    local status="🟢"

    local format=""
    format+="CRC32:    %{crc32}\n"
    format+="MD5:      %{md5}\n"
    format+="SHA-1:    %h\n"
    format+="SHA-256:  %{sha-256}\n"
    format+="SHA-512:  %{sha-512}\n"
    format+="SHA3-256: %{sha3-256}\n"
    format+="SHA3-512: %{sha3-512}\n"
    format+="BLAKE2s:  %{blake2s}\n"
    format+="BLAKE2b:  %{blake2b}"

    # Run the main process.
    std_output=$(_run_in_sandbox "$output_dir" "false" \
        rhash --printf="$format" -- "$input_file" 2>/dev/null)

    if [[ -z "$std_output" ]]; then
        status="🔴"
    fi

    # Prepend the filename.
    std_output="$status __MSG_File__: \"$(_text_remove_pwd "$input_file")\""$'\n'"$std_output"

    _storage_text_write "$std_output$ITEM_SEP"
}

_main "$@"

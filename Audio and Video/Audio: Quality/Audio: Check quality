#!/usr/bin/env bash
# install_mime_type=audio/*;
# install_icon_kde=checkmark

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "sox"
    _display_wait_box ""
    input_files=$(_get_files "par_type=file; par_select_mime='audio/|video/'")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$input_files" "$output_dir"

    local std_output=""
    std_output=$(_storage_text_read_all)
    std_output=$(_str_sort "$std_output" "$FIELD_SEPARATOR" "false")

    # Translate some strings from the '$std_output'.
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_High__|$(_i18n 'High')|g" <<<"$std_output")
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_Medium__|$(_i18n 'Medium')|g" <<<"$std_output")
    # shellcheck disable=SC2001
    std_output=$(sed "s|__MSG_Low__|$(_i18n 'Low')|g" <<<"$std_output")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'files')
        par_columns='--column:$(_i18n 'Quality'),--column:$(_i18n 'File')'
        par_action=open_location
        par_check_type=checkbox
    "
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""

    local str_high="🟢 __MSG_High__"
    local str_medium="🟠 __MSG_Medium__"
    local str_low="🔴 __MSG_Low__"
    local status=$str_low

    # NOTE: The 'sinc' filter fails when the band is not below the Nyquist
    # frequency, and rates up to 40 kHz cannot contain the 19k-20k band.
    local sample_rate=""
    sample_rate=$(_run_in_sandbox "$output_dir" "false" \
        soxi -r "$input_file" 2>/dev/null)
    if [[ "$sample_rate" =~ ^[0-9]+$ ]] && ((sample_rate <= 40000)); then
        _storage_text_write "$status$COL_SEP$(_text_remove_pwd "$input_file")"
        return 0
    fi

    # Run the main process.
    std_output=$(_run_in_sandbox "$output_dir" "false" \
        sox "$input_file" -n remix 1 sinc "19k-20k" stat 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    std_output=$(grep --ignore-case "^Mean.*norm" <<<"$std_output")
    std_output=$(cut -d ":" -f 2 <<<"$std_output")
    std_output=$(tr -d " " <<<"$std_output")

    status=$str_high
    if [[ -z "$std_output" ]]; then
        status="$str_low"
    elif [[ "$std_output" == "0.00000"* ]]; then
        status="$str_medium"
    fi

    if [[ "$status" == "$str_medium" ]]; then
        std_output=$(_run_in_sandbox "$output_dir" "false" \
            sox "$input_file" -n remix 1 sinc "17k-18k" stat 2>&1)
        _check_output "$?" "$std_output" "$input_file" "" || return 1

        std_output=$(grep --ignore-case "^Mean.*norm" <<<"$std_output")
        std_output=$(cut -d ":" -f 2 <<<"$std_output")
        std_output=$(tr -d " " <<<"$std_output")

        if [[ -z "$std_output" ]]; then
            status="$str_low"
        elif [[ "$std_output" == "0.00000"* ]]; then
            status="$str_low"
        fi
    fi

    _storage_text_write "$status$COL_SEP$(_text_remove_pwd "$input_file")"
}

_main "$@"

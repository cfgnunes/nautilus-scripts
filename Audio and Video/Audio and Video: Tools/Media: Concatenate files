#!/usr/bin/env bash
# install_mime_type=audio/*;video/*;
# install_icon_kde=merge

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "ffmpeg"
    _display_wait_box ""
    _get_files "
        par_type=file
        par_select_mime='audio/|video/'
        par_min_items=2
        par_sort_list=true
    " "input_files"
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    _main_task "$output_dir" "${input_files[@]}"
    _display_result_box "$output_dir"
}

_main_task() {
    local output_dir=$1
    local -a input_files=("${@:2}")
    local output_file=""
    local std_output=""

    local file_1=${input_files[0]}

    # Get the extension of the first file to use it for the output file.
    local filename_extension=""
    filename_extension=$(_get_filename_extension "$file_1")

    # Create the input list for the 'ffmpeg'.
    local temp_file=""
    temp_file=$(_make_temp_file)

    # ffmpeg concat demuxer: a quote inside the path is '\'' .
    local escaped_quote="'\\''"
    printf "file '%s'\n" "${input_files[@]//\'/$escaped_quote}" >"$temp_file"

    output_file=$(_get_output_filename \
        "Concatenated media$filename_extension" "$output_dir" \
        "par_extension_opt=preserve")

    # Run the main process.
    std_output=$(_run_in_sandbox "$output_dir" "false" \
        ffmpeg -hide_banner -y \
        -f "concat" \
        -safe 0 \
        -i "$temp_file" \
        -- "$output_file" 2>&1)
    _check_output "$?" "$std_output" "" "$output_file" || return 1
}

_main "$@"

#!/usr/bin/env bash
# install_mime_type=audio/*;video/*;inode/directory;
# install_icon_kde=documentinfo

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "mediainfo"
    _display_wait_box ""
    input_files=$(_get_files "
        par_type=file
        par_recursive=true
        par_select_mime='audio/|video/'
    ")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$input_files" "$output_dir"

    local std_output=""
    std_output=$(_storage_text_read_all)
    std_output=$(_str_sort "$std_output" "$FIELD_SEPARATOR" "false")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'files')
        par_columns='--column:$(_i18n 'Duration'),--column:$(_i18n 'Album'),'
        par_columns+='--column:$(_i18n 'Artist'),--column:$(_i18n 'Title'),'
        par_columns+='--column:$(_i18n 'File')'
        par_action=open_location
        par_check_type=checkbox
    "
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""

    # Run the main process.
    std_output=$(_run_in_sandbox "$output_dir" "false" \
        mediainfo \
        --Inform="General;Duration:%Duration/String3%\nAlbum:%Album%\nTitle:%Title%\nPerformer:%Performer%" \
        -- "$input_file" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    local tag_duration=""
    local tag_album=""
    local tag_artist=""
    local tag_title=""
    tag_duration=$(grep -o -P -m1 "^Duration:\K.*" <<<"$std_output" | sed "s|\.[0-9][0-9]*$||")
    tag_album=$(grep -o -P -m1 "^Album:\K.*" <<<"$std_output")
    tag_artist=$(grep -o -P -m1 "^Performer:\K.*" <<<"$std_output")
    tag_title=$(grep -o -P -m1 "^Title:\K.*" <<<"$std_output")

    _storage_text_write "$tag_duration$COL_SEP$tag_album$COL_SEP$tag_artist$COL_SEP$tag_title$COL_SEP$(_text_remove_pwd "$input_file")"
}

_main "$@"

#!/usr/bin/env bash
# install_mime_type=audio/mpeg;inode/directory;
# install_icon_kde=documentinfo

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "mediainfo"
    _display_wait_box ""
    input_files=$(_get_files "
        par_type=file
        par_recursive=true
        par_select_extension=mp3
        par_skip_extension=bak
    ")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$input_files" "$output_dir"

    local std_output=""
    std_output=$(_storage_text_read_all)
    std_output=$(_str_sort "$std_output" "$FIELD_SEPARATOR" "false")

    _display_list_box "$std_output" "
        par_item_name=$(_i18n 'files')
        par_columns='--column:$(_i18n 'Mode'),--column:$(_i18n 'Bit rate'),'
        par_columns+='--column:$(_i18n 'Sampling rate'),'
        par_columns+='--column:$(_i18n 'Channels'),--column:$(_i18n 'File')'
        par_action=open_location
        par_check_type=checkbox
    "
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""

    # Run the main process.
    std_output=$(_run_in_sandbox "$output_dir" "false" \
        mediainfo \
        --Inform="Audio;BitRate_Mode:%BitRate_Mode%\nBitRate:%BitRate/String%\nSamplingRate:%SamplingRate/String%\nChannel(s):%Channel(s)/String%" \
        -- "$input_file" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    local mode=""
    local bit_rate=""
    local sampling_rate=""
    local channels=""
    mode=$(grep -o -P -m1 "^BitRate_Mode:\K.*" <<<"$std_output")
    bit_rate=$(grep -o -P -m1 "^BitRate:\K.*" <<<"$std_output")
    sampling_rate=$(grep -o -P -m1 "^SamplingRate:\K.*" <<<"$std_output")
    channels=$(grep -o -P -m1 "^Channel[^:]+:\K.*" <<<"$std_output")

    _storage_text_write "$mode$COL_SEP$bit_rate$COL_SEP$sampling_rate$COL_SEP$channels$COL_SEP$(_text_remove_pwd "$input_file")"
}

_main "$@"

#!/usr/bin/env bash
# install_mime_type=audio/mpeg;
# install_icon_kde=tag

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "mediainfo"
    _display_wait_box ""
    input_files=$(_get_files "
        par_type=file
        par_select_extension=mp3
        par_skip_extension=bak
    ")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$input_files" "$output_dir"
    _display_result_box ""
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""

    # Run the main process.
    std_output=$(_run_in_sandbox "" "false" \
        mediainfo \
        --Inform="General;Title:%Title%\nPerformer:%Performer%" -- \
        "$input_file" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    local tag_artist=""
    local tag_title=""
    tag_artist=$(grep -o -P -m1 "^Performer:\K.*" <<<"$std_output")
    tag_title=$(grep -o -P -m1 "^Title:\K.*" <<<"$std_output")

    # EXT4 filenames cannot contain '/'.
    tag_artist=${tag_artist//\//, }
    tag_title=${tag_title//\//, }

    # Use only the tags that are present. Skip files without any tag.
    local new_name=""
    if [[ -n "$tag_artist" && -n "$tag_title" ]]; then
        new_name="$tag_artist - $tag_title"
    else
        new_name="$tag_artist$tag_title"
    fi
    if [[ -z "$new_name" ]]; then
        _check_output "1" "No artist or title tag found." "$input_file" "" || return 1
    fi

    # Rename the file.
    local dir_file=""
    dir_file=$(_get_dirname "$input_file")
    _move_file "rename" "$input_file" \
        "$dir_file/$new_name.mp3" || return 1
}

_main "$@"

#!/usr/bin/env bash
# install_icon_kde=edit-rename

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _display_wait_box ""
    _get_files "par_type=all" "input_files"

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "input_files" "$output_dir"
    _display_result_box ""
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local output_file=""
    local dir=""
    local filename=""
    local filename_base=""
    local filename_extension=""

    dir=$(dirname -- "$input_file")
    filename=$(basename -- "$input_file")

    # Directories do not have an extension.
    if [[ -d "$input_file" ]]; then
        filename_base=$filename
        filename_extension=""
    else
        filename_base=$(_strip_filename_extension "$filename")
        filename_extension=$(_get_filename_extension "$filename")
    fi

    # Gaps by dashes (only in the base name, never in the extension).
    output_file=$(tr -s -- "_ \t" "-" <<<"$filename_base")

    # Trim the separator from both ends of the base name.
    output_file=${output_file#"${output_file%%[!-]*}"}
    output_file=${output_file%"${output_file##*[!-]}"}

    # Keep the original base name if nothing is left.
    if [[ -z "$output_file" ]]; then
        output_file=$filename_base
    fi
    output_file+=$filename_extension

    # Run the main process.
    _move_file "skip" "$input_file" "$dir/$output_file" || return 1
}

_main "$@"

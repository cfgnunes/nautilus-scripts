#!/usr/bin/env bash
# shellcheck disable=SC2001

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    _display_wait_box ""
    input_files=$(_get_files "par_type=all")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$input_files" "$output_dir"
    _display_result_box ""
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local output_file=""

    local dir=""
    local filename=""
    local filename_extension=""
    dir=$(dirname -- "$input_file")
    filename=$(basename -- "$input_file")
    filename_extension=$(_get_filename_extension "$input_file")
    output_file=$filename

    # Transform similar ' characters.
    output_file=$(sed "s|"$'\u0060'"|'|g" <<<"$output_file") # Grave accent.
    output_file=$(sed "s|"$'\u00b4'"|'|g" <<<"$output_file") # Acute accent.
    output_file=$(sed "s|"$'\u2018'"|'|g" <<<"$output_file") # Left single quotation.
    output_file=$(sed "s|"$'\u2019'"|'|g" <<<"$output_file") # Right single quotation.

    # Transform similar - characters.
    output_file=$(sed "s|"$'\u2010'"|-|g" <<<"$output_file")

    # Transform to title case.
    output_file=$(sed "s|\(\w\)\(\w*\)|\U\1\L\2|g" <<<"$output_file")

    # Words to lowercase.
    local words=""
    # English articles/prepositions.
    words="a|an|and|as|at|but|by|for|from|if|in|nor|of|on|or|per|the|to|via|with|yet"
    # Portuguese articles/prepositions.
    words+="|a|ao|aos|as|e|o|os|um|uns|uma|umas|com|da|das|de|desde|do|dos|em|na|nas|no|nos|ou|pra|para|pela|pelas|pelo|pelos|por|se|sob|sobre"
    # Spanish articles/prepositions.
    words+="|el|la|los|las|del|al"
    words+="|von|è|é"
    output_file=$(sed -E "s/ ($words)\b/ \L\1/gI" <<<"$output_file")

    # Uppercase the beginning of sentences.
    output_file=$(sed -E "s|([-\.])(\s\w)|\1\U\2|g" <<<"$output_file")

    # Fix words with ' character.
    output_file=$(sed "s|\('\w\)|\L\1|gI" <<<"$output_file")
    # Surname-style O' always capitalized, d'/l' capitalized only at start
    # (Italian/French particles stay lowercase mid-title: d'Amore, l'Amour).
    output_file=$(sed -E "s/(^| )(o'\w)/\1\U\2/gI" <<<"$output_file")
    # Mid-title Italian/French particles: d'Amore, l'Amour (lowercase prefix).
    output_file=$(sed -E "s/ (d')(\w)/ \L\1\U\2/gI" <<<"$output_file")
    output_file=$(sed -E "s/ (l')(\w)/ \L\1\U\2/gI" <<<"$output_file")
    # Capitalize d'/l' at start of the name or after "- "/".".
    output_file=$(sed -E "s/^(d'\w)/\U\1/gI" <<<"$output_file")
    output_file=$(sed -E "s/^(l'\w)/\U\1/gI" <<<"$output_file")
    output_file=$(sed -E "s/([-\.] )(d'\w)/\1\U\2/gI" <<<"$output_file")
    output_file=$(sed -E "s/([-\.] )(l'\w)/\1\U\2/gI" <<<"$output_file")
    output_file=$(sed -E "s/(^| )o' /\1O' /gI" <<<"$output_file")
    output_file=$(sed "s|'em |'Em |gI" <<<"$output_file")
    output_file=$(sed "s| '\(\w\)| '\U\1|gI" <<<"$output_file")

    # Fix common uppercase word abbreviations.
    words="[0-9]\w|ac|api|sql|aka|asap|ceo|cfo|cto|dc|diy|dna|faq|isbn|ko|mtv|rpg|rpm|tv|usa|vip"
    words+="|bios|cmos|fifa|gba|nba|nes|nfl|nhl|rom|snes|uml"
    words+="|4wd|acme|aiii|aso|espn|fc|fx|gp|gs|gt|gx|hal|mlbpa|mvp|nasa|ncaa|nhlpa|np|ntsc|pal|pga|qix|roc|rs|sd|sfc|sm|sos|swat|swiv|tko|tnn|wcw|wgp|wwf|wwii"
    # Fix band names (in uppercase).
    words+="|abba|abc|chic|inxs|iza|kc|klb|mgmt|ppf|sza|toto|twrp|vcr"
    output_file=$(sed -E "s/\b($words)\b/\U\1/gI" <<<"$output_file")

    # Japanese suffixes.
    output_file=$(sed "s|-chan\b|-chan|gI" <<<"$output_file")
    output_file=$(sed "s|-ji\b|-ji|gI" <<<"$output_file")
    output_file=$(sed "s|-jigen\b|-jigen|gI" <<<"$output_file")
    output_file=$(sed "s|-jima\b|-jima|gI" <<<"$output_file")
    output_file=$(sed "s|-jou\b|-jou|gI" <<<"$output_file")
    output_file=$(sed "s|-kun\b|-kun|gI" <<<"$output_file")
    output_file=$(sed "s|-nichi\b|-nichi|gI" <<<"$output_file")
    output_file=$(sed "s|-nin\b|-nin|gI" <<<"$output_file")
    output_file=$(sed "s|-san\b|-san|gI" <<<"$output_file")
    output_file=$(sed "s|-tou\b|-tou|gI" <<<"$output_file")
    output_file=$(sed "s|-ui\b|-ui|gI" <<<"$output_file")

    # Fix the some specific cases.
    output_file=$(sed "s| vs | vs |gI" <<<"$output_file")
    output_file=$(sed "s| vs\. | vs. |gI" <<<"$output_file")
    output_file=$(sed "s|-in-|-in-|gI" <<<"$output_file")
    output_file=$(sed "s|-on-|-on-|gI" <<<"$output_file")
    output_file=$(sed "s|\bmig\b|MiG|gI" <<<"$output_file")
    output_file=$(sed "s|\bno\. |No. |gI" <<<"$output_file")
    output_file=$(sed "s|\bphd\b|PhD|gI" <<<"$output_file")

    # Fix the some specific words.
    output_file=$(sed "s|\bactraiser\b|ActRaiser|gI" <<<"$output_file")
    output_file=$(sed "s|\bducktales\b|DuckTales|gI" <<<"$output_file")
    output_file=$(sed "s|\bfamicombox\b|FamicomBox|gI" <<<"$output_file")
    output_file=$(sed "s|\bimagefight\b|ImageFight|gI" <<<"$output_file")
    output_file=$(sed "s|\bmechwarrior\b|MechWarrior|gI" <<<"$output_file")
    output_file=$(sed "s|\broadblasters\b|RoadBlasters|gI" <<<"$output_file")
    output_file=$(sed "s|\brobocop\b|RoboCop|gI" <<<"$output_file")
    output_file=$(sed "s|\bsimcity\b|SimCity|gI" <<<"$output_file")
    output_file=$(sed "s|\bstartropics\b|StarTropics|gI" <<<"$output_file")
    output_file=$(sed "s|\btwinbee\b|TwinBee|gI" <<<"$output_file")
    output_file=$(sed "s|\bwbattlecity\b|BattleCity|gI" <<<"$output_file")
    output_file=$(sed "s|\bwrestlemania\b|WrestleMania|gI" <<<"$output_file")

    # 'US' only in release tags (avoid English pronoun 'us').
    output_file=$(sed -E "s|\bus( [0-9])|US\1|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bus mix\b|US Mix|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bus version\b|US Version|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bus remaster\b|US Remaster|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bus edition\b|US Edition|gI" <<<"$output_file")

    # Fix some band names.
    output_file=$(sed -E "s|\ba-ha\b|a-ha|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bceelo\b|CeeLo|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bmagic!|MAGIC!|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bonerepublic\b|OneRepublic|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bsixpence none the richer\b|Sixpence None The Richer|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bthe la's\b|The La's|gI" <<<"$output_file")
    output_file=$(sed -E "s|\bthe the\b|The The|gI" <<<"$output_file")
    # Band ERA only as leading artist token (avoid PT verb 'era').
    output_file=$(sed -E "s|^era -|ERA -|gI" <<<"$output_file")

    # Fix some words.
    output_file=$(sed -E "s|\btik tok\b|TiK ToK|gI" <<<"$output_file")

    # Fix Scottish/Irish Mc* surnames (McCartney, McKenzie, ...).
    output_file=$(sed -E "s/\bMc([a-z])/Mc\u\1/g" <<<"$output_file")

    # Fix the some specific cases: 'featuring' word.
    output_file=$(sed "s|\bfeat\. |feat. |gI" <<<"$output_file")
    output_file=$(sed "s|\bfeaturing |featuring |gI" <<<"$output_file")

    # Fix the some specific cases: article 'the'.
    output_file=$(sed "s|, a |, A |gI" <<<"$output_file")
    output_file=$(sed "s|, an |, An |gI" <<<"$output_file")
    output_file=$(sed "s|, the |, The |gI" <<<"$output_file")
    # Also when the article is at the end or before ')' / '.'.
    output_file=$(sed -E "s/, (a|an|the)([.)])/, \u\1\2/gI" <<<"$output_file")
    output_file=$(sed "s|\& the |\& The |gI" <<<"$output_file")
    #output_file=$(sed "s|\band the |and The |gI" <<<"$output_file")

    # Fix English 'no'/'do' incorrectly lowercased as Portuguese particles.
    output_file=$(sed -E "s/\bno more\b/No More/gI" <<<"$output_file")
    output_file=$(sed -E "s/\b(with|for|have|get|got) no\b/\1 No/gI" <<<"$output_file")
    output_file=$(sed -E "s/\b(can|bad) do\b/\1 Do/gI" <<<"$output_file")

    # Portuguese expression.
    output_file=$(sed -E "s|\bao vivo\b|Ao Vivo|gI" <<<"$output_file")

    # Fix the some specific cases: some roman numbers.
    output_file=$(sed -E "s/ (X{0,3}(IX|IV|V?I{1,3}|V)|X{1,3})\b/ \U\1/gI" <<<"$output_file")

    # Fix the some specific cases: classical songs.
    output_file=$(sed "s| in a minor| in A Minor|gI" <<<"$output_file")
    output_file=$(sed "s| in e minor| in E Minor|gI" <<<"$output_file")
    output_file=$(sed "s| in a major| in A Major|gI" <<<"$output_file")
    output_file=$(sed "s| in e major| in E Major|gI" <<<"$output_file")
    output_file=$(sed "s| in a flat| in A Flat|gI" <<<"$output_file")
    output_file=$(sed "s| in e flat| in E Flat|gI" <<<"$output_file")
    output_file=$(sed "s| in a sharp| in A Sharp|gI" <<<"$output_file")
    output_file=$(sed "s| in e sharp| in E Sharp|gI" <<<"$output_file")
    words="bwv|hwv|rv|wwv"
    output_file=$(sed -E "s/\b($words)\b/\U\1/gI" <<<"$output_file")
    output_file=$(sed "s|\bwoo\b|WoO|gI" <<<"$output_file")

    # Fix abbreviations with one letter character (ASCII only; avoid é./è.).
    output_file=$(sed "s| \([A-Za-z]\.\)| \U\1|gI" <<<"$output_file")

    # Strip the extension.
    output_file=$(_strip_filename_extension "$output_file")

    # Capitalize the last word (standard title case), including before ' ('.
    output_file=$(sed -E "s|\b(\w)(\w*) \(|\u\1\2 (|" <<<"$output_file")
    output_file=$(sed -E "s/\b(\w)(\w*)$/\u\1\2/" <<<"$output_file")
    # Article after comma at end of the basename (e.g. 'One, the').
    output_file=$(sed -E "s/, (a|an|the)$/, \u\1/gI" <<<"$output_file")

    # Portuguese verb 'for' after common subordinators, not English prep 'For'.
    output_file=$(sed -E "s/\b(se|quando|como|onde|quem) For\b/\1 for/g" <<<"$output_file")

    # Run the main process.
    _move_file "skip" "$input_file" "$dir/$output_file${filename_extension,,}" || return 1
}

_main "$@"

#!/usr/bin/env bash
# install_icon_kde=globe
# install_keyboard_shortcut=<Control><Alt>W

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()

    # Execute initial checks.
    _check_dependencies "git"
    _display_wait_box ""
    # NOTE: Using 'par_type=all' because the script can run
    # even when the file manager selects a file or directory.
    _get_files "par_type=all; par_max_items=20" "input_files"

    # Run the main process.
    _open_repository_website "${input_files[@]}"

    _display_result_box ""
}

# Function: _convert_git_to_web_url
#
# Description:
#   This function converts a Git remote URL into a web-compatible URL for
#   browser access.
#
# Parameters:
#   $1 (git_url): The Git remote URL to convert. It can be in various
#      formats, such as:
#      - HTTPS (e.g., https://github.com/user/repo.git)
#      - SSH (e.g., git@github.com:user/repo.git or
#        ssh://git@github.com/user/repo.git)
#      - Git protocol (e.g., git://github.com/user/repo.git)
_convert_git_to_web_url() {
    local git_url=$1
    local web_url=""

    git_url=${git_url//@ssh\./@}

    # Remove trailing slashes and the '.git' suffix.
    git_url=${git_url%/}
    git_url=${git_url%.git}

    if [[ "$git_url" =~ ^https?:// ]]; then
        # HTTP(S) URL: remove credentials (user:token@) to avoid leaking them.
        web_url=$(sed -E 's|^(https?://)[^/@]*@|\1|' <<<"$git_url")
    elif [[ "$git_url" =~ ^(ssh|git):// ]]; then
        # ssh:// or git:// URL with any user and optional SSH port
        # (the SSH port is not the web port, so it is dropped).
        web_url=$(sed -E 's|^(ssh\|git)://([^/@]*@)?([^/:]+)(:[0-9]*)?/|https://\3/|' <<<"$git_url")
    elif [[ "$git_url" =~ ^[^/@]+@[^/:]+: ]]; then
        # SCP-like SSH URL (e.g., git@github.com:user/repo.git)
        web_url=$(sed -E 's|^[^/@]+@([^:/]+):/?|https://\1/|' <<<"$git_url")
    else
        return 1
    fi

    printf "%s" "$web_url"
}

# Function: _open_repository_website
#
# Description:
#   This function opens the website corresponding to the remote Git repository
#   for one or more directories.
#
# Parameters:
#   $@ (input_files): The directories to process, one per argument.
_open_repository_website() {
    local -a input_files=("$@")

    # Iterate over each input file (directory).
    local input_file=""
    for input_file in "${input_files[@]}"; do

        # If the input is not a directory, get its parent directory.
        if [[ ! -d "$input_file" ]]; then
            input_file=$(dirname -- "$input_file")
        elif [[ "$input_file" == *".git" && -d "${input_file%".git"}" ]] &&
            ! git -C "$input_file" rev-parse --git-dir &>/dev/null; then
            input_file=${input_file%".git"}
        fi

        # Check if the selected directory is a Git repository.
        local top_level=""
        top_level=$(LC_ALL=C.UTF-8 git -C "$input_file" rev-parse --show-toplevel 2>&1)
        _check_output "$?" "$top_level" "$input_file" "" || continue

        # Temporary lock to prevent operations on the same repository.
        local lock_key=""
        lock_key=$(md5sum <<<"$top_level")
        lock_key=${lock_key%% *}
        local filename_lock="$TEMP_DIR_FILENAME_LOCKS/$lock_key"

        # Skip this item if the repository was already processed.
        mkdir "$filename_lock" 2>/dev/null || continue

        # Retrieve the URL of the remote 'origin' repository for the Git
        # repository.
        local git_url=""
        git_url=$(LC_ALL=C.UTF-8 git -C "$input_file" remote get-url origin 2>/dev/null)
        _check_output "$?" "Could not get the url from the Git repository." \
            "$input_file" "" || continue

        # Convert the Git remote URL into a web-compatible URL
        # (e.g., from SSH/HTTPS Git URL to a browser-accessible URL).
        local web_url=""
        web_url=$(_convert_git_to_web_url "$git_url")

        # If a valid web URL was generated, open it in the default web browser.
        if [[ -n "$web_url" ]]; then
            xdg-open "$web_url" &>/dev/null &
        else
            local msg=""
            msg="$(_i18n 'No remote URL found.')"
            _log_error "$msg" "$input_file" "" ""
        fi
    done
}

_main "$@"

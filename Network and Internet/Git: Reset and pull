#!/usr/bin/env bash
# install_icon_kde=vcs-pull
# install_keyboard_shortcut=<Control><Shift>R

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "git"
    _display_wait_box ""
    # NOTE: Using 'par_type=all' because the script can run
    # even when the file manager selects a file or directory.
    _get_files "par_type=all; par_max_items=20" "input_files"

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "input_files" "$output_dir"

    _display_result_box ""
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""
    local branch=""

    # If the input is not a directory, get its parent directory.
    if [[ ! -d "$input_file" ]]; then
        input_file=$(dirname -- "$input_file")
    elif [[ "$input_file" == *".git" ]]; then
        input_file=${input_file%".git"}
    fi

    # Check if the selected directory is a Git repository.
    local top_level=""
    top_level=$(LC_ALL=C.UTF-8 git -C "$input_file" rev-parse --show-toplevel 2>&1)
    _check_output "$?" "$top_level" "$input_file" "" || return 1

    # Temporary lock to prevent operations on the same repository.
    local lock_key=""
    lock_key=$(md5sum <<<"$top_level")
    lock_key=${lock_key%% *}
    local filename_lock="$TEMP_DIR_FILENAME_LOCKS/$lock_key"
    mkdir "$filename_lock" 2>/dev/null || return 1

    # Move into the repository directory.
    _directory_push "$top_level" || return 1

    # -------------------------------------------------------------------------
    # Step 1: Ensure repository integrity.
    # Abort any unfinished merge or rebase to prevent conflicts.
    # -------------------------------------------------------------------------
    git merge --abort &>/dev/null
    git rebase --abort &>/dev/null
    # Remove any leftover rebase directories if they exist.
    rmdir "$(LC_ALL=C.UTF-8 git rev-parse --git-path rebase-apply)" &>/dev/null
    rmdir "$(LC_ALL=C.UTF-8 git rev-parse --git-path rebase-merge)" &>/dev/null

    # -------------------------------------------------------------------------
    # Step 2: Clean working directory.
    # Remove untracked and ignored files/directories,
    # discard local changes, and clear all stashes.
    # -------------------------------------------------------------------------
    std_output=$(LC_ALL=C.UTF-8 git clean -xffd 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # Discard all local changes (reset to last committed state).
    std_output=$(LC_ALL=C.UTF-8 git reset --hard 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # Clear all stashes.
    std_output=$(LC_ALL=C.UTF-8 git stash clear 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # -------------------------------------------------------------------------
    # Step 3: Fetch from all remotes, including tags.
    # Prune stale remote-tracking branches and tags.
    # -------------------------------------------------------------------------
    std_output=$(LC_ALL=C.UTF-8 GIT_TERMINAL_PROMPT=0 git fetch --all --tags --prune --prune-tags --force 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # -------------------------------------------------------------------------
    # Step 4: Determine and switch to the correct branch.
    # Use the current branch, or the remote default if HEAD is detached.
    # If origin no longer has that branch, switch to the default and delete
    # the orphan local branch (except desenv, develop, main, master).
    # -------------------------------------------------------------------------
    local skip_branches="desenv|develop|main|master"
    local default_branch=""
    local orphan_branch=""

    default_branch=$(LC_ALL=C.UTF-8 git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    if [[ -z "$default_branch" ]]; then
        default_branch=$(LC_ALL=C.UTF-8 GIT_TERMINAL_PROMPT=0 git remote show origin 2>/dev/null | grep "HEAD branch" | sed "s|.*: ||")
    fi

    branch=$(LC_ALL=C.UTF-8 git symbolic-ref --short HEAD 2>/dev/null || echo "")
    if [[ -z "$branch" ]]; then
        branch="$default_branch"
    fi

    # Remote branch is gone: move to the default branch first.
    if ! git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
        orphan_branch="$branch"
        branch="$default_branch"
    fi

    # Switch to the detected branch.
    std_output=$(LC_ALL=C.UTF-8 git switch "$branch" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # Delete the orphan local branch after leaving it (cannot delete HEAD).
    if [[ -n "$orphan_branch" && "$orphan_branch" != "$branch" && ! "$orphan_branch" =~ ^($skip_branches)$ ]]; then
        std_output=$(LC_ALL=C.UTF-8 git branch --delete --force "$orphan_branch" 2>&1)
        _check_output "$?" "$std_output" "$input_file" "" || return 1
    fi

    # -------------------------------------------------------------------------
    # Step 5: Force reset to match the remote branch exactly.
    # Ensures the local repository is identical to 'origin/<branch>'.
    # -------------------------------------------------------------------------
    std_output=$(LC_ALL=C.UTF-8 git reset --hard "origin/$branch" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # Update submodules to the commits recorded by the remote branch.
    std_output=$(LC_ALL=C.UTF-8 git submodule update --init --recursive --force 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # Discard local changes and remove untracked and ignored files in submodules.
    std_output=$(LC_ALL=C.UTF-8 git submodule foreach --recursive 'git reset --hard && git clean -xffd' 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # -------------------------------------------------------------------------
    # Step 6: Delete local branches that are not on the remote.
    # Names in skip_branches (desenv, develop, main, master) are never deleted.
    # -------------------------------------------------------------------------
    local local_branches=""
    local_branches=$(LC_ALL=C.UTF-8 git branch --format="%(refname:short)")

    local remote_branches=""
    remote_branches=$(LC_ALL=C.UTF-8 git branch -r --format="%(refname:short)" | sed 's|^origin/||')

    local -a branches_delete=()
    IFS=$'\n' read -r -d '' -a branches_delete < <(
        grep -vxE "($skip_branches)" <<<"$local_branches" |
            grep -vxFf <(printf '%s\n' "$remote_branches")
    ) || true

    # Force-delete them in a single command.
    if ((${#branches_delete[@]} > 0)); then
        std_output=$(LC_ALL=C.UTF-8 git branch --delete --force -- "${branches_delete[@]}" 2>&1)
        _check_output "$?" "$std_output" "$input_file" "" || return 1
    fi

    # Return to the previous directory.
    _directory_pop || return 1
}

_main "$@"

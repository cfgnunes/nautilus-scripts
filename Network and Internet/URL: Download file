#!/usr/bin/env bash
# install_icon_kde=edit-download
# install_keyboard_shortcut=<Control><Shift>X

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    if _command_exists "aria2c" ||
        _command_exists "curl" ||
        _command_exists "wget" ||
        _command_exists "wget2"; then
        _check_dependencies_clipboard ""
    else
        _check_dependencies_clipboard "axel"
    fi
    _display_wait_box ""
    # NOTE: Using 'par_type=all' because the script can run
    # even when the file manager selects a file or directory.
    input_files=$(_get_files "par_type=all")
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$(_prepare_input "$input_files")" "$output_dir"
    _display_result_box "$output_dir"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""
    local timeout_value=5
    local num_connections=10
    local exit_code=0

    # Add a scheme if missing (axel and aria2c fail without it).
    if [[ ! "$input_file" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then
        input_file="https://$input_file"
    fi

    # Run the main process.
    if _command_exists "axel"; then
        std_output=$(_run_in_sandbox "$output_dir" "true" \
            axel \
            --insecure \
            --no-clobber \
            --num-connections="$num_connections" \
            --timeout="$timeout_value" \
            --output="$output_dir" \
            -- "$input_file" 2>&1)
    elif _command_exists "aria2c"; then
        std_output=$(_run_in_sandbox "$output_dir" "true" \
            aria2c \
            --check-certificate=false \
            --allow-overwrite=false \
            --auto-file-renaming=false \
            --max-connection-per-server="$num_connections" \
            --split="$num_connections" \
            --timeout="$timeout_value" \
            --dir="$output_dir" \
            -- "$input_file" 2>&1)
    elif _command_exists "curl"; then
        std_output=$(_run_in_sandbox "$output_dir" "true" \
            curl \
            --globoff \
            --insecure \
            --location \
            --fail \
            --show-error \
            --remote-name \
            --output-dir "$output_dir" \
            --connect-timeout "$timeout_value" \
            -- "$input_file" 2>&1)
    elif _command_exists "wget2"; then
        std_output=$(_run_in_sandbox "$output_dir" "true" \
            wget2 \
            --no-check-certificate \
            --no-clobber \
            --chunk-size=1M \
            --max-threads="$num_connections" \
            --timeout="$timeout_value" \
            --directory-prefix="$output_dir" \
            -- "$input_file" 2>&1)
    elif _command_exists "wget"; then
        std_output=$(_run_in_sandbox "$output_dir" "true" \
            wget \
            --no-check-certificate \
            --no-clobber \
            --timeout="$timeout_value" \
            --directory-prefix="$output_dir" \
            -- "$input_file" 2>&1)
    fi
    exit_code=$?

    # The 'wget' and 'wget2' return 0 when '--no-clobber' skips an existing file.
    if ((exit_code == 0)) && [[ "$std_output" == *"already there; not retrieving"* ]]; then
        exit_code=1
    fi

    _check_output "$exit_code" "$std_output" "$input_file" "" || return 1
}

# Function: _extract_urls
#
# Description:
#   This function extracts unique URLs or domain-like strings from input text.
#   It matches three main types:
#    - URLs with IP addresses (with optional port and path)
#    - URLs with domain names (with optional port, path, or subdomains)
#    - Plain domain names, with or without "www."
#
# Example matches:
#  - http://192.168.0.1:8080/api
#  - https://google.com/favicon.ico
#  - www.google.com
#
# Parameters:
#   $1 (data): The input text.
#   $2 (loose): If "true", also match domains without scheme or "www."
#      (e.g. google.com/favicon.ico). Use it only for text typed by the
#      user, because in arbitrary text it matches file names like "main.py".
_extract_urls() {
    local data=$1
    local loose=${2:-false}
    local re_ip="https?://(?:[0-9]{1,3}\.){3}[0-9]{1,3}"
    local re_port_path="(?::[0-9]+)?(?:/[^[:space:]'\"\)\]\>]*)?"
    local re_domain="https?://[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}"
    local re_plain="(?:www\.)[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}"

    if [[ "$loose" == "true" ]]; then
        re_plain="(?<![@\w.-])[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*\.[a-zA-Z]{2,}$re_port_path"
    fi

    if [[ -z "$data" ]]; then
        return
    fi

    data=$(grep --only-matching --perl-regexp \
        "($re_ip$re_port_path|$re_domain$re_port_path|$re_plain)" <<<"$data" |
        sed "s|[,.;:!?]*$||" | sort --unique)

    printf "%s" "$data"
}

_prepare_input() {
    local input_files=$1
    local data=""
    local urls=""
    local msg=""

    # Split the list into an array.
    local -a items=()
    read -r -d "" -a items < <(printf "%s" "$input_files")

    data=$(grep \
        --binary-files=without-match \
        --directories=skip \
        --devices=skip \
        --no-messages \
        --no-filename \
        "" -- "${items[@]}")
    urls=$(_extract_urls "$data")

    # If there are no valid URLs in the files,
    # get the URLs from the clipboard.
    if [[ -z "$urls" ]]; then
        local clipboard_data=""
        clipboard_data=$(_get_clipboard_data)
        urls=$(_extract_urls "$clipboard_data")
    fi

    if [[ -z "$urls" ]]; then
        msg+="$(_i18n 'Enter the URLs.')"
        msg+="\n\n"
        msg+="$(_i18n 'Example:') https://google.com/favicon.ico"
        data=$(_display_input_text_box "$msg" "")
        urls=$(_extract_urls "$data" "true")
    fi

    if [[ -z "$urls" ]]; then
        local msg=""
        msg="$(_i18n 'There are no valid URLs in the clipboard or in the selected files!')"
        _display_error_box "$msg"
        _exit_script
    fi

    _convert_text_to_delimited_string "$urls"
}

_main "$@"

#!/usr/bin/env bash
# install_icon_kde=vcs-branch
# install_keyboard_shortcut=<Control><Shift>G

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local -a url_items=()
    local output_dir=""

    # Execute initial checks.
    _check_dependencies_clipboard "git"
    _display_wait_box ""
    # NOTE: Using 'par_type=all' because the script can run
    # even when the file manager selects a file or directory.
    _get_files "par_type=all" "input_files"
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    # Execute the function '_main_task' for each file in parallel.
    readarray -d "$ITEM_SEP" -t url_items < <(_prepare_input "${input_files[@]}")
    _run_task_parallel "url_items" "$output_dir"
    _display_result_box "$output_dir"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local std_output=""
    local param="core.sshCommand=ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=3"

    __git_repo_dir_name() {
        local repo_url=$1
        local dir_name=""

        # Remove possible trailing slash from the URL.
        repo_url=${repo_url%/}

        # Extract the part after the last slash and remove .git if present.
        dir_name=$(basename -- "$repo_url")
        dir_name=${dir_name%.git}

        printf "%s\n" "$dir_name"
    }

    local repo_dir_name=""
    repo_dir_name=$(__git_repo_dir_name "$input_file")

    # Determine the directory name for cloning.
    local dir_name=""
    dir_name=$(_get_output_filename "$output_dir/$repo_dir_name" "$output_dir" "par_extension_opt=preserve")

    # Run the main process.
    # Attempt 1: Try cloning using SSH as-is.
    local exit_code=0
    std_output=$(LC_ALL=C.UTF-8 git -c "$param" clone -q -- "$input_file" "$dir_name" 2>&1)
    exit_code=$?

    # Attempt 2: If the first attempt failed,
    # try SSH with '@ssh.' inserted in the host
    # (only for URLs with a user and without HTTP(S) credentials).
    if ((exit_code != 0)) && [[ "$input_file" == *"@"* ]] &&
        [[ "$input_file" != *"@ssh."* && ! "$input_file" =~ ^https?:// ]]; then
        std_output=$(LC_ALL=C.UTF-8 git -c "$param" clone -q -- "${input_file/@/@ssh.}" "$dir_name" 2>&1)
        exit_code=$?
    fi

    # If SSH attempts failed, try converting SSH URL to HTTPS and clone.
    if ((exit_code != 0)); then
        # Convert SSH to HTTPS form.
        local https_url=${input_file/@ssh./@}
        https_url=$(sed -E 's#git@([^:]+):([^/]+)/([^ ]+)#https://\1/\2/\3#g' <<<"$https_url")
        # Skip if the URL did not change (the same clone would be repeated).
        if [[ "$https_url" != "$input_file" ]]; then
            input_file=$https_url
            std_output=$(LC_ALL=C.UTF-8 git -c "$param" clone -q -- "$input_file" "$dir_name" 2>&1)
            exit_code=$?
        fi
    fi

    _check_output "$exit_code" "$std_output" "$input_file" "" || return 1
}

_extract_git_urls() {
    local data=$1

    if [[ -z "$data" ]]; then
        return
    fi

    # Convert HTTPS to SSH form (URLs with credentials or a port are kept as is).
    data=$(sed -E 's#https://([^/@:]+)/([^/]+)/([^ ]+)#git@\1:\2/\3#g' <<<"$data")

    # Append ".git" to each URL line where it is missing.
    data=$(sed -E '/^(git@|(https?|ssh|git):\/\/)/{s#/+$##; /\.git$/!s#$#.git#}' <<<"$data")

    # Keep only valid Git URLs.
    data=$(grep --only-matching --perl-regexp "(?<![^\s,;\"'<>(])(git@|ssh://|git://|https?://)[^\s,;\"'<>]*?\.git(?=[\s,;\"'<>)]|\$)" <<<"$data")
    data=$(sort --unique <<<"$data")

    printf "%s" "$data"
}

_prepare_input() {
    local -a input_files=("$@")
    local data=""
    local urls=""

    data=$(grep \
        --binary-files=without-match \
        --directories=skip \
        --devices=skip \
        --no-messages \
        --no-filename \
        "" -- "${input_files[@]}")
    urls=$(_extract_git_urls "$data")

    # If there are no valid URLs in the files,
    # get the URLs from the clipboard.
    if [[ -z "$urls" ]]; then
        local clipboard_data=""
        clipboard_data=$(_get_clipboard_data)
        urls=$(_extract_git_urls "$clipboard_data")
    fi

    if [[ -z "$urls" ]]; then
        local msg=""
        msg="$(_i18n 'There are no valid URLs in the clipboard or in the selected files!')"
        _display_error_box "$msg"
        _exit_script
    fi

    _convert_text_to_delimited_string "$urls"
}

_main "$@"

#!/usr/bin/env bash
# install_keyboard_shortcut=<Shift><Alt>V
# install_icon_kde=edit-paste

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local output_dir=""

    # Execute initial checks.
    _check_dependencies_clipboard ""
    _display_wait_box ""
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    # Run the main process.
    _save_file_from_clipboard "$output_dir"

    _display_result_box "$output_dir"
}

_save_file_from_clipboard() {
    local output_dir=$1

    # Determine which clipboard tool is available (Wayland or X11) and list the
    # available clipboard data types (MIME types).
    local clipboard_types=""
    if [[ "$(_get_session_type)" == "wayland" ]]; then
        clipboard_types=$(wl-paste --list-types 2>/dev/null)
    else
        clipboard_types=$(xclip -selection clipboard -t TARGETS -o 2>/dev/null)
    fi

    # Supported MIME types in priority order, as "mime=extension".
    local -a mime_array=(
        "text/plain;charset=utf-8=txt"
        "text/plain=txt"
        "image/png=png"
        "image/jpeg=jpg"
        "image/webp=webp"
        "image/bmp=bmp"
        "text/html=html"
        "application/pdf=pdf"
        "application/json=json"
        "text/markdown=md"
        "text/uri-list=uri"
        "text/x-shellscript=sh"
        "UTF8_STRING=txt"
        "STRING=txt"
        "TEXT=txt"
    )

    # Find the first supported MIME type in clipboard data (exact line match).
    local supported_type=""
    local ext=""
    local entry=""
    for entry in "${mime_array[@]}"; do
        supported_type=$(grep -Fx -m1 -- "${entry%=*}" <<<"$clipboard_types")
        if [[ -n "$supported_type" ]]; then
            ext=${entry##*=}
            break
        fi
    done

    if [[ -z "$supported_type" ]]; then
        local msg=""
        msg="$(_i18n 'Unsupported clipboard type.')"
        _display_error_box "$msg"
        _exit_script
    fi

    # Define file extension and output filename.
    local basename="Clipboard"
    local output_file=""
    output_file=$(_get_output_filename "$basename.$ext" "$output_dir" "par_extension_opt=preserve")

    # Extract clipboard content and save to output file.
    local status=0
    if [[ "$(_get_session_type)" == "wayland" ]]; then
        wl-paste --no-newline --type "$supported_type" >"$output_file" 2>/dev/null || status=$?
    else
        xclip -selection clipboard -t "$supported_type" -o >"$output_file" 2>/dev/null || status=$?
    fi

    # Remove the empty file left behind on failure, so the name is not kept.
    if ((status != 0)); then
        rm -f -- "$output_file"
    fi
    _check_output "$status" "" "" "$output_file" || return 1

    # If it's a text file, try to detect the programming language.
    if [[ "$ext" == "txt" ]]; then
        ext=$(_detect_text_language "$output_file")

        # If a specific language is detected, rename the file accordingly.
        if [[ "$ext" != "txt" ]]; then
            _move_file "rename" "$output_file" "$output_dir/$basename.$ext"
        fi
    fi
}

# Function: _detect_text_language
#
# Description:
#   This function infers the file type of a text file based on its first
#   non-empty line. Returns "txt" if not recognized.
#
# Parameters:
#   $1 (file): Path to the text file to analyze.
_detect_text_language() {
    local file=$1
    local ext="txt"

    # Get the first non-empty line, without leading spaces.
    local first_line=""
    first_line=$(grep -m1 -v "^[[:space:]]*$" "$file" | sed "s/^[[:space:]]*//")

    # Detect type by the first line.
    case "${first_line,,}" in
    "#!"*bash* | "#!"*zsh* | "#!"*dash* | "#!"*ksh* | "#!"*fish*) ext="sh" ;;
    "#!"*/sh | "#!"*/sh\ * | "#!"*env\ sh*) ext="sh" ;;
    "#!"*python*) ext="py" ;;
    "#!"*perl*) ext="pl" ;;
    "#!"*ruby*) ext="rb" ;;
    "#!"*php* | "<?php"*) ext="php" ;;
    "#!"*node*) ext="js" ;;
    "#!"*lua*) ext="lua" ;;
    "#!"*rscript*) ext="R" ;;
    "#!"*awk*) ext="awk" ;;
    "<svg"*) ext="svg" ;;
    "<?xml"*) ext="xml" ;;
    "<!doctype html"* | "<html"*) ext="html" ;;
    esac

    printf "%s" "$ext"
}

_main "$@"

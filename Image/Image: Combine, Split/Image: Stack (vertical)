#!/usr/bin/env bash
# install_mime_type=image/*;
# install_icon_kde=distribute-vertical

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "magick"
    _display_wait_box ""
    _get_files "
        par_type=file
        par_select_mime=image/
        par_min_items=2
        par_sort_list=true
    " "input_files"
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    _main_task "$output_dir" "${input_files[@]}"
    _display_result_box "$output_dir"
}

_main_task() {
    local output_dir=$1
    local -a input_files=("${@:2}")
    local output_file=""
    local std_output=""

    output_file=$(_get_output_filename \
        "Stacked images (vertical).png" "$output_dir" \
        "par_extension_opt=preserve")

    # Run the main process.
    std_output=$(_cmd_magick_in_sandbox "$output_dir" convert \
        "${input_files[@]}" \
        -append \
        +repage \
        "$output_file" 2>&1)
    _check_output "$?" "$std_output" "" "$output_file" || return 1
}

_main "$@"

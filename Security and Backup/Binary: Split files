#!/usr/bin/env bash
# install_icon_kde=split

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""
    local msg=""

    # Execute initial checks.
    _display_wait_box ""
    input_files=$(_get_files "par_type=file")

    msg="$(_i18n 'Enter the size of the output files.')"
    msg+="\n\n"
    msg+="$(_i18n 'Example:') 5M"
    TASK_CHUNK_SIZE=$(_display_input_text_box "$msg" "")
    TASK_CHUNK_SIZE=${TASK_CHUNK_SIZE^^}

    # Parse a size accepted by GNU split. Unitless values are megabytes.
    if [[ ! "$TASK_CHUNK_SIZE" =~ ^[[:space:]]*([0-9]+)(B|K|M|G|T|P|E|Z|Y|KB|MB|GB|TB|PB|EB|ZB|YB)?[[:space:]]*$ ]]; then
        msg="$(_i18n 'Invalid input!')"
        _display_error_box "$msg"
        _exit_script
    fi
    TASK_CHUNK_SIZE="${BASH_REMATCH[1]}${BASH_REMATCH[2]:-M}"
    export TASK_CHUNK_SIZE

    # Check output directory only after displaying dialog boxes to the user.
    output_dir=$(_get_output_dir "par_use_same_dir=false")

    # Execute the function '_main_task' for each file in parallel.
    _run_task_parallel "$input_files" "$output_dir"
    _display_result_box "$output_dir"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local prefix=""
    local std_output=""

    prefix="$output_dir/$(basename -- "$input_file").part."

    # Run the main process.
    std_output=$(split -b "$TASK_CHUNK_SIZE" -d -a 3 -- "$input_file" "$prefix" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1
}

_main "$@"

#!/usr/bin/env bash
# install_icon_kde=merge

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _display_wait_box ""
    _get_files "
        par_type=file
        par_min_items=2
        par_sort_list=true
    " "input_files"
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    _main_task "$output_dir" "${input_files[@]}"
    _display_result_box "$output_dir"
}

_main_task() {
    local output_dir=$1
    local -a input_files=("${@:2}")
    local output_file=""
    local std_output=""

    local file_1=""
    file_1=${input_files[0]}

    # Remove the path.
    local filename=""
    filename=$(basename -- "$file_1")

    # Remove the number ('.000', '.001') suffixes.
    if [[ "$filename" =~ \.[0-9]+$ ]]; then
        filename=${filename%.*}
        # Remove the '.part' suffix if it exists.
        if [[ "${filename,,}" =~ \.part$ ]]; then
            filename=${filename%.*}
        fi
    fi

    output_file=$(_get_output_filename "$filename" "$output_dir" \
        "par_extension_opt=preserve")

    # Run the main process.
    cat -- "${input_files[@]}" >"$output_file" 2>/dev/null
    _check_output "$?" "$std_output" "" "$output_file" || return 1
}

_main "$@"

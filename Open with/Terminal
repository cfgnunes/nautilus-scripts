#!/usr/bin/env bash
# install_mime_type=inode/directory;
# install_icon_kde=system-run
# install_keyboard_shortcut=F4

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""

    # Execute initial checks.
    input_files=$(_get_files "par_type=directory; par_max_items=20")
    _unset_global_variables_file_manager

    # Run the main process.
    _open_app "$input_files"
}

_open_app() {
    local input_files=$1
    local available_app=""
    # shellcheck disable=SC2034
    local -a apps=(
        "ptyxis"         # GNOME default.
        "gnome-terminal" # GNOME default (old).
        "kgx"            # GNOME default (new).
        "konsole"        # KDE default.
        "mate-terminal"  # MATE default.
        "xfce4-terminal" # XFCE default.
        "xterm"
        "kitty"
        "alacritty"
        "terminator"
        "qterminal"
        "deepin-terminal"
        "terminology"
        "uxterm"
        "termit"
        "foot"
    )
    available_app=$(_get_available_app "apps")

    # Iterate over each input file (directory).
    local input_file=""
    # Disable pathname expansion so names like '*' or '?' are not expanded
    # when '$input_files' is unquoted (IFS splits only on '$FIELD_SEPARATOR').
    set -f
    for input_file in $input_files; do
        # Detect remote SFTP paths from GVfs, KIO FUSE, or a URI.
        if [[ "$input_file" == *"sftp:"* ]]; then
            local remote_host=""
            local remote_path=""
            if [[ "$input_file" =~ ^/run/user/[0-9]+/gvfs/sftp:host=([^/]+)(/.*)?$ ]]; then
                # Case 1: GVfs mount format,
                # such as: /run/user/.../gvfs/sftp:host=host/path.
                remote_host="${BASH_REMATCH[1]}"
                remote_path="${BASH_REMATCH[2]}"
            elif [[ "$input_file" =~ ^/run/user/[0-9]+/kio-fuse-[^/]+/sftp/([^/]+)(/.*)?$ ]]; then
                # Case 2: KIO FUSE mount format,
                # such as: /run/user/.../kio-fuse-.../sftp/user@host/path.
                remote_host="${BASH_REMATCH[1]}"
                remote_path="${BASH_REMATCH[2]}"
            elif [[ "$input_file" =~ ^sftp://([^/]+)/?(.*)$ ]]; then
                # Case 3: URI format,
                # such as: sftp://host/path.
                remote_host="${BASH_REMATCH[1]}"
                remote_path="/${BASH_REMATCH[2]}"
            fi

            # Build the remote command.
            local remote_cmd=""
            printf -v remote_cmd 'cd -- %q; exec bash' "${remote_path:-/}"
            # shellcheck disable=SC2016
            local -a ssh_run=(bash -c 'exec ssh -t -- "$1" "$2"' _
                "$remote_host" "$remote_cmd")

            case "$available_app" in
            gnome-terminal | mate-terminal)
                $available_app -- "${ssh_run[@]}" &
                ;;
            ptyxis)
                $available_app --new-window -- "${ssh_run[@]}" &
                ;;
            konsole | xfce4-terminal)
                $available_app --hold -e "${ssh_run[@]}" &
                ;;
            *)
                # Generic fallback.
                $available_app -e "${ssh_run[@]}" &
                ;;
            esac
        else
            # Local directory case.
            if [[ "$available_app" == "ptyxis" ]]; then
                $available_app --new-window --working-directory "$input_file" &
            else
                cd -- "$input_file" || continue
                unset "OLDPWD"
                $available_app &
            fi
        fi
    done
    set +f
}

_main "$@"

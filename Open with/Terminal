#!/usr/bin/env bash
# install_mime_type=inode/directory;
# install_icon_kde=system-run
# install_keyboard_shortcut=F4

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""

    # Execute initial checks.
    input_files=$(_get_files "par_type=directory; par_max_items=20")
    _unset_global_variables_file_manager

    # Run the main process.
    _open_app "$input_files"
}

_open_app() {
    local input_files=$1
    local app=""

    # shellcheck disable=SC2034
    local -a apps=(
        "ptyxis"         # GNOME default.
        "gnome-terminal" # GNOME default (old).
        "kgx"            # GNOME default (new).
        "konsole"        # KDE default.
        "mate-terminal"  # MATE default.
        "xfce4-terminal" # XFCE default.
        "xterm"
        "kitty"
        "alacritty"
        "terminator"
        "qterminal"
        "deepin-terminal"
        "terminology"
        "uxterm"
        "termit"
        "foot"
    )
    app=$(_get_available_app "apps") || _exit_script

    # Split the list into an array.
    local -a items=()
    read -r -a items <<<"$input_files"

    # Iterate over each input file (directory).
    local input_file=""
    for input_file in "${items[@]}"; do
        # Detect remote SFTP paths from GVfs, KIO FUSE, or a URI.
        if [[ "$input_file" == *"sftp:"* ]]; then
            _open_remote_directory "$app" "$input_file"
        else
            _open_local_directory "$app" "$input_file"
        fi
    done
}

# Open a terminal in a local directory.
_open_local_directory() {
    local app=$1
    local directory=$2

    if [[ "$app" == "ptyxis" ]]; then
        "$app" --new-window --working-directory "$directory" &
    else
        cd -- "$directory" || exit 1
        unset "OLDPWD"
        "$app" &
    fi
}

# Open a terminal with an SSH session in a remote directory.
_open_remote_directory() {
    local app=$1
    local input_file=$2
    local remote_host=""
    local remote_port=""
    local remote_path=""
    local -a parsed=()

    # Output lines: host, port, and path.
    mapfile -t parsed < <(_parse_sftp_path "$input_file")
    remote_host=${parsed[0]:-}
    remote_port=${parsed[1]:-}
    remote_path=${parsed[2]:-}

    # Skip entries that did not match any SFTP format.
    if [[ -z "$remote_host" ]]; then
        return 1
    fi

    # Build the remote command.
    local remote_cmd=""
    printf -v remote_cmd 'cd -- %q; exec bash' "${remote_path:-/}"
    local -a cmd_run=(ssh -t)
    if [[ -n "$remote_port" ]]; then
        cmd_run+=(-p "$remote_port")
    fi
    cmd_run+=(-- "$remote_host" "$remote_cmd")

    case "$app" in
    gnome-terminal | mate-terminal)
        "$app" -- "${cmd_run[@]}" &
        ;;
    ptyxis)
        "$app" --new-window -- "${cmd_run[@]}" &
        ;;
    konsole | xfce4-terminal)
        "$app" --hold -e "${cmd_run[@]}" &
        ;;
    *)
        # Generic fallback.
        "$app" -e "${cmd_run[@]}" &
        ;;
    esac
}

# Parse an SFTP path from GVfs, KIO FUSE, or a URI.
# Print three lines: host (with optional "user@"), port, and remote path.
_parse_sftp_path() {
    local input_file=$1
    local host=""
    local port=""
    local path=""

    if [[ "$input_file" =~ ^/run/user/[0-9]+/gvfs/sftp:host=([^/]+)(/.*)?$ ]]; then
        # Case 1: GVfs mount format,
        # such as: /run/user/.../gvfs/sftp:host=host,user=name,port=22/path.
        host="${BASH_REMATCH[1]}"
        path="${BASH_REMATCH[2]}"
        if [[ "$host" =~ ,port=([0-9]+) ]]; then
            port="${BASH_REMATCH[1]}"
        fi
        if [[ "$host" =~ ,user=([^,]+) ]]; then
            host="${BASH_REMATCH[1]}@${host%%,*}"
        else
            host="${host%%,*}"
        fi
    elif [[ "$input_file" =~ ^/run/user/[0-9]+/kio-fuse-[^/]+/sftp/([^/]+)(/.*)?$ ]]; then
        # Case 2: KIO FUSE mount format,
        # such as: /run/user/.../kio-fuse-.../sftp/user@host:port/path.
        host="${BASH_REMATCH[1]}"
        path="${BASH_REMATCH[2]}"
        _split_host_port host port
    elif [[ "$input_file" =~ ^sftp://([^/]+)/?(.*)$ ]]; then
        # Case 3: URI format,
        # such as: sftp://user@host:port/path.
        host="${BASH_REMATCH[1]}"
        path="/${BASH_REMATCH[2]}"
        _split_host_port host port
    else
        return 1
    fi

    printf "%s\n" "$host" "$port" "$path"
}

# Split a trailing ":port" from the host variable (passed by name).
_split_host_port() {
    local -n _host=$1
    local -n _port=$2

    if [[ "$_host" =~ ^(.+):([0-9]+)$ ]]; then
        _host="${BASH_REMATCH[1]}"
        _port="${BASH_REMATCH[2]}"
        # Remove the brackets of IPv6 literals, such as: [::1].
        _host="${_host#\[}"
        _host="${_host%\]}"
    fi
}

_main "$@"

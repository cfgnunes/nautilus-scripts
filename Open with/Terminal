#!/usr/bin/env bash
# install_mime_type=inode/directory;
# install_icon_kde=system-run
# install_keyboard_shortcut=F4

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()

    # Execute initial checks.
    _get_files "par_type=directory; par_max_items=20" "input_files"
    _unset_global_variables_file_manager

    # Run the main process.
    _open_app "${input_files[@]}"
}

_open_app() {
    local -a input_files=("$@")
    local app=""

    local -a apps=(
        "ptyxis"         # GNOME default.
        "gnome-terminal" # GNOME default (old).
        "kgx"            # GNOME default (new).
        "konsole"        # KDE default.
        "mate-terminal"  # MATE default.
        "xfce4-terminal" # XFCE default.
        "xterm"
        "kitty"
        "alacritty"
        "terminator"
        "qterminal"
        "deepin-terminal"
        "terminology"
        "uxterm"
        "termit"
        "foot"
    )
    app=$(_get_available_app "apps") || _exit_script

    # Iterate over each input file (directory).
    local input_file=""
    for input_file in "${input_files[@]}"; do
        # Detect remote SFTP paths from GVfs, KIO FUSE, or a URI.
        if [[ "$input_file" == /run/user/*/gvfs/sftp:* ||
            "$input_file" == /run/user/*/kio-fuse-*/sftp/* ||
            "$input_file" == sftp://* ]]; then
            _open_remote_directory "$app" "$input_file"
        else
            _open_local_directory "$app" "$input_file"
        fi
    done
}

# Open a terminal in a local directory.
_open_local_directory() {
    local app=$1
    local directory=$2

    if [[ "$app" == "ptyxis" ]]; then
        "$app" --new-window --working-directory "$directory" &
    else
        cd -- "$directory" || exit 1
        unset "OLDPWD"
        "$app" &
    fi
}

# Open a terminal with an SSH session in a remote directory.
_open_remote_directory() {
    local app=$1
    local input_file=$2
    local host=""
    local port=""
    local path=""

    # Skip entries that did not match any SFTP format.
    _parse_sftp_path "$input_file" "host" "port" "path" || return 1

    # Build the remote command.
    local remote_cmd=""
    printf -v remote_cmd 'cd -- %q; exec bash' "${path:-/}"
    local -a cmd_run=(ssh -t)
    if [[ -n "$port" ]]; then
        cmd_run+=(-p "$port")
    fi
    cmd_run+=(-- "$host" "$remote_cmd")

    case "$app" in
    gnome-terminal | mate-terminal)
        "$app" -- "${cmd_run[@]}" &
        ;;
    ptyxis)
        "$app" --new-window -- "${cmd_run[@]}" &
        ;;
    konsole)
        "$app" --hold -e "${cmd_run[@]}" &
        ;;
    xfce4-terminal)
        "$app" --hold -x "${cmd_run[@]}" &
        ;;
    terminator)
        "$app" -x "${cmd_run[@]}" &
        ;;
    *)
        # Generic fallback.
        "$app" -e "${cmd_run[@]}" &
        ;;
    esac
}

# Parse an SFTP path from GVfs, KIO FUSE, or a URI.
# Set three variables (passed by name): host (with optional "user@"), port,
# and remote path.
_parse_sftp_path() {
    local input_file=$1
    local -n _host=$2
    local -n _port=$3
    local -n _path=$4

    if [[ "$input_file" =~ ^/run/user/[0-9]+/gvfs/sftp:host=([^/]+)(/.*)?$ ]]; then
        # Case 1: GVfs mount format,
        # such as: /run/user/.../gvfs/sftp:host=host,user=name,port=22/path.
        _host="${BASH_REMATCH[1]}"
        _path="${BASH_REMATCH[2]}"
        if [[ "$_host" =~ ,port=([0-9]+) ]]; then
            _port="${BASH_REMATCH[1]}"
        fi
        if [[ "$_host" =~ ,user=([^,]+) ]]; then
            _host="${BASH_REMATCH[1]}@${_host%%,*}"
        else
            _host="${_host%%,*}"
        fi
    elif [[ "$input_file" =~ ^/run/user/[0-9]+/kio-fuse-[^/]+/sftp/([^/]+)(/.*)?$ ]]; then
        # Case 2: KIO FUSE mount format,
        # such as: /run/user/.../kio-fuse-.../sftp/user@host:port/path.
        _host="${BASH_REMATCH[1]}"
        _path="${BASH_REMATCH[2]}"
        _split_host_port "_host" "_port"
    elif [[ "$input_file" =~ ^sftp://([^/]+)/?(.*)$ ]]; then
        # Case 3: URI format,
        # such as: sftp://user@host:port/path.
        _host="${BASH_REMATCH[1]}"
        _path="/${BASH_REMATCH[2]}"
        _split_host_port "_host" "_port"
    else
        return 1
    fi
}

# Split a trailing ":port" from the host variable (passed by name).
_split_host_port() {
    local -n _split_host=$1
    local -n _split_port=$2

    if [[ "$_split_host" =~ ^(.+):([0-9]+)$ ]]; then
        _split_host="${BASH_REMATCH[1]}"
        _split_port="${BASH_REMATCH[2]}"
        # Remove the brackets of IPv6 literals, such as: [::1].
        _split_host="${_split_host#\[}"
        _split_host="${_split_host%\]}"
    fi
}

_main "$@"

#!/usr/bin/env bash
# install_icon_kde=system-run
# install_keyboard_shortcut=F7

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""

    # Execute initial checks.
    input_files=$(_get_files "par_type=all; par_max_items=20")
    _unset_global_variables_file_manager

    # Run the main process.
    _open_app "$input_files"
}

_open_app() {
    local input_files=$1

    # Check if the first file is a binary file.
    local file_1=""
    file_1=$(_get_element "$input_files" "1")

    # Split the list into an array.
    local -a items=()
    read -r -a items <<<"$input_files"

    if [[ ! -d "$file_1" ]]; then
        if [[ "$(_get_file_encoding "$file_1")" == "binary" &&
            -s "$file_1" ]]; then
            if _is_qt_desktop; then
                _check_dependencies "okteta"
                okteta -- "${items[@]}" &
            else
                _check_dependencies "ghex"
                ghex -- "${items[@]}" &
            fi
            exit 0
        fi
    fi

    # Run the main process.
    local available_app=""
    # shellcheck disable=SC2034
    local -a apps=(
        "code"
        "cursor"
        "windsurf"
        "kiro"
        "antigravity"
        "subl"
        "codium"
        "geany"
        "gnome-text-editor" # GNOME default.
        "gedit"             # GNOME default (old).
        "kate"              # KDE default.
        "xed"               # Cinnamon/MATE default.
        "mousepad"          # XFCE default.
    )
    available_app=$(_get_available_app "apps")

    if [[ -z "$available_app" ]]; then
        available_app=$(_xdg_get_default_app "text/plain")
    fi

    "$available_app" -- "${items[@]}" &
}

_main "$@"

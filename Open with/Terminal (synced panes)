#!/usr/bin/env bash
# install_mime_type=inode/directory;
# install_icon_kde=system-run
# install_keyboard_shortcut=<Shift>F4

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""

    # Execute initial checks.
    _check_dependencies "tmux"
    input_files=$(_get_files "par_type=directory; par_max_items=20")
    _unset_global_variables_file_manager

    # Run the main process.
    _open_app "$input_files"
}

_open_app() {
    local input_files=$1
    local session_name="s$$"

    _build_tmux_session "$session_name" "$input_files"
    _open_terminal "$session_name"
}

# Create a tmux session with one synchronized pane per directory.
_build_tmux_session() {
    local session_name=$1
    local input_files=$2

    # Split the list into an array.
    local -a items=()
    read -r -a items <<<"$input_files"

    # Create a new tmux session in detached mode, in the first directory.
    tmux new-session -d -s "$session_name" -c "${items[0]}"

    # Enable synchronized panes for the session.
    tmux setw -t "$session_name" synchronize-panes on

    # Enable mouse support.
    tmux set-option -g mouse on

    # Enable keyboard shortcuts for synchronized panes (CTRL+B and '=').
    tmux bind = setw synchronize-panes

    # Add one pane for each remaining directory.
    local input_file=""
    for input_file in "${items[@]:1}"; do
        tmux split-window -t "$session_name" -c "$input_file"
        tmux select-layout -t "$session_name" tiled >/dev/null
    done

    # Select the first pane.
    tmux select-pane -t "$session_name:0.0"
}

# Open a terminal attached to the tmux session.
_open_terminal() {
    local session_name=$1
    local app=""

    # shellcheck disable=SC2034
    local -a apps=(
        "ptyxis"         # GNOME default.
        "gnome-terminal" # GNOME default (old).
        "kgx"            # GNOME default (new).
        "konsole"        # KDE default.
        "mate-terminal"  # MATE default.
        "xfce4-terminal" # XFCE default.
        "xterm"
        "kitty"
        "alacritty"
        "terminator"
        "qterminal"
        "deepin-terminal"
        "terminology"
        "uxterm"
        "termit"
        "foot"
    )
    app=$(_get_available_app "apps") || _exit_script

    local -a cmd_run=(tmux attach-session -t "$session_name")

    case "$app" in
    gnome-terminal | mate-terminal)
        "$app" -- "${cmd_run[@]}" &
        ;;
    ptyxis)
        "$app" --new-window -- "${cmd_run[@]}" &
        ;;
    konsole | xfce4-terminal)
        "$app" --hold -e "${cmd_run[@]}" &
        ;;
    *)
        # Generic fallback.
        "$app" -e "${cmd_run[@]}" &
        ;;
    esac
}

_main "$@"

#!/usr/bin/env bash
# install_icon_kde=document-encrypted

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local -a input_files=()
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "tar gpg"
    _display_wait_box ""
    _get_files "par_type=all" "input_files"

    TASK_PASSWORD=$(_display_password_box_define) || _exit_script
    export TASK_PASSWORD

    # Check output directory only after displaying dialog boxes to the user.
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    # Execute the function '_main_task' for each file in parallel.
    export -f _run_gpg
    _run_task_parallel "input_files" "$output_dir"
    _display_result_box "$output_dir"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local output_file=""
    local std_output=""

    # Determine if the input is a directory or a file.
    if [[ -d "$input_file" ]]; then
        # Check if the directory is empty.
        if _is_directory_empty "$input_file"; then
            local msg=""
            msg="The directory is empty."
            _log_error "$msg" "$input_file" "" "$output_file"
            return 1
        fi

        # Generate the output filename for directories.
        output_file=$(_get_output_filename "$input_file" "$output_dir" \
            "par_extension_opt=append; par_extension=tar.gpg")

        # Create a temporary local directory for archiving.
        local basename=""
        local temp_dir_local=""
        basename=$(basename -- "$input_file")             # Remove the path.
        basename=$(_strip_filename_extension "$basename") # Remove the extension.
        temp_dir_local=$(_make_temp_dir_local "$output_dir" ".$basename") || return 1

        # Archive the contents of the directory into a temporary tar file.
        local temp_archive="$temp_dir_local/archive.tar"
        _directory_push "$input_file" || return 1
        local -a items=()
        # Include hidden files in the archive.
        shopt -s dotglob
        items=(*)
        shopt -u dotglob
        std_output=$(_run_in_sandbox "$output_dir" "false" \
            tar -cf "$temp_archive" -- "${items[@]}" 2>&1)
        _check_output "$?" "$std_output" "$input_file" "$temp_archive" || return 1
        _directory_pop || return 1

        # Encrypt the archived file using GPG.
        _run_gpg "$temp_archive" "$output_file"

        # Remove the temporary directory (local directory).
        rm -rf -- "$temp_dir_local"
    else
        # Generate the output filename for regular files.
        output_file=$(_get_output_filename "$input_file" "$output_dir" \
            "par_extension_opt=append; par_extension=gpg")

        # Encrypt the input file directly using GPG.
        _run_gpg "$input_file" "$output_file"
    fi
}

_run_gpg() {
    local input_file=$1
    local output_file=$2
    local std_output=""

    # The password is sent via stdin (printf is a builtin) so
    # it does not appear in the process list or in /proc/<pid>/.
    std_output=$(printf '%s' "$TASK_PASSWORD" | gpg --batch --yes \
        --symmetric \
        --pinentry-mode loopback \
        --passphrase-fd 0 \
        --output "$output_file" \
        -- "$input_file" 2>&1)

    _check_output "$?" "$std_output" "$input_file" "$output_file" || return 1
}

_main "$@"

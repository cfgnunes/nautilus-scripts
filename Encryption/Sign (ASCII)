#!/usr/bin/env bash
# install_mime_type=all/allfiles;
# install_icon_kde=document-edit-sign

# Source the file '.common-functions.sh'.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR=$(grep --only-matching "^.*scripts[^/]*" <<<"$SCRIPT_DIR")
source "$ROOT_DIR/.common-functions.sh"

_main() {
    local input_files=""
    local output_dir=""

    # Execute initial checks.
    _check_dependencies "gpg"
    _display_wait_box ""
    input_files=$(_get_files "par_type=file")

    local id_sign=""
    id_sign=$(_get_id_sign)

    # Check output directory only after displaying dialog boxes to the user.
    output_dir=$(_get_output_dir "par_use_same_dir=true")

    # Execute the function '_main_task' for each file in parallel.
    export -f _main_task
    _run_function_parallel "$input_files" "$ITEM_SEP" "" \
        "_main_task" "$output_dir" "$id_sign"
    _display_result_box "$output_dir"
}

_main_task() {
    local input_file=$1
    local output_dir=$2
    local id_sign=$3
    local output_file=""
    local std_output=""

    output_file=$(_get_output_filename "$input_file" "$output_dir" \
        "par_extension_opt=append; par_extension=asc")

    # '--clearsign' normalizes line endings and trailing spaces, so the
    # signature would not match a binary file.
    if [[ -s "$input_file" && "$(LC_ALL=C.UTF-8 file --dereference --brief \
        --mime-encoding -- "$input_file" 2>/dev/null)" == "binary" ]]; then
        _log_error "$(_i18n 'Invalid input file!')" "$input_file" "" ""
        return 1
    fi

    # Run the main process.
    std_output=$(gpg --batch --yes \
        --clearsign \
        --local-user "$id_sign" \
        --output "$output_file" \
        -- "$input_file" 2>&1)

    _check_output "$?" "$std_output" "$input_file" "$output_file" || return 1
}

_import_key() {
    local input_file=""
    local std_output=""

    input_file=$(_display_file_selection_box \
        "$(_i18n 'Select a key file to import')" \
        "$(_i18n 'Key files') | *.asc *.gpg *.pgp")
    [[ -f "$input_file" ]] || return 1

    # Import the key.
    std_output=$(LC_ALL=C.UTF-8 gpg --batch --yes --import "$input_file" 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1

    # Set the trust level to 'ultimate' for every primary key in the file.
    std_output=$(LC_ALL=C.UTF-8 gpg --with-colons --import-options show-only \
        --import "$input_file" 2>/dev/null |
        awk -F: '$1=="pub" || $1=="sec" {p=1; next} $1=="fpr" && p {print $10 ":6:"; p=0}' |
        gpg --batch --yes --import-ownertrust 2>&1)
    _check_output "$?" "$std_output" "$input_file" "" || return 1
}

_get_id_sign() {
    local msg=""
    local id_sign=""

    local keys=""
    keys=$(_get_secret_keys)
    if [[ -z "$keys" ]]; then
        msg+="$(_i18n 'No secret keys were found.')"
        msg+="\n\n"
        msg+="$(_i18n 'Would you like to import a key now?')"
        if ! _display_question_box "$msg"; then
            _exit_script
        fi
        _import_key
        keys=$(_get_secret_keys)
        if [[ -z "$keys" ]]; then
            msg="$(_i18n 'Failed to import the key!')"
            _display_error_box "$msg"
            _exit_script
        fi
    fi

    keys=$(tr ":\n" "$COL_SEP$ITEM_SEP" <<<"$keys")
    id_sign=$(_display_select_box "$keys" \
        "--column:$(_i18n 'Name'),--column:$(_i18n 'E-mail'),--column:$(_i18n 'Created'),--column:$(_i18n 'Expires'),--column:$(_i18n 'Key ID')" \
        "radiolist" "first" \
        "$(_i18n 'Select a user (sign):')")

    if [[ -z "$id_sign" ]]; then
        msg="$(_i18n 'You must select a user!')"
        _display_error_box "$msg"
        _exit_script
    fi

    printf "%s" "$id_sign"
}

_get_secret_keys() {
    {
        LC_ALL=C.UTF-8 gpg --list-secret-keys --with-colons | awk -F: '
        # When the main key is found.
        $1=="sec" {
            keyid=$5
            created_ts=$6
            expire_ts=$7

            # Format creation date.
            cmd="date -d @" created_ts " +\"%Y-%m-%d\""
            cmd | getline created
            close(cmd)

            # Format expiration date (may be empty).
            expire=""
            if (expire_ts != "") {
                cmd2="date -d @" expire_ts " +\"%Y-%m-%d\""
                cmd2 | getline expire
                close(cmd2)
            }
        }

        # Extract name and email.
        $1=="uid" {
            split($10, a, " <|>")
            name=a[1]
            email=a[2]
            print name ":" email ":" created ":" expire ":" keyid
        }'
    } 2>/dev/null
}

_main "$@"
